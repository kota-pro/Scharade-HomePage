---
import ActivityShareButton from "../components/ActivityShareButton.astro";
import MemberIcon from "../components/MemberIcon.astro";
import StaffLayout from "../layouts/StaffLayout.astro";
import { readActivities } from "../lib/activities";
import { activityDate } from "../lib/activityTypes";
import { isExecutive } from "../lib/roles.ts";
const data = readActivities();
const events = [...data.events].sort((a, b) =>
  b.createdAt.localeCompare(a.createdAt),
);
---

<StaffLayout title="Management">
  <h2 class="staff-dashboard-heading">管理・運営</h2>
  {
    Astro.url.searchParams.has("deleted") && (
      <p role="status">企画と関連する通知を削除しました。</p>
    )
  }
  <div class="admin-intro"><p>企画やお知らせ、写真展、班分け、サイトの掲載内容を管理できます。</p></div>
  <section class="admin-section">
    <h2>サイトの掲載内容</h2>
    <ul class="admin-link-list">
      <li><a href="/Management/gallery"><MemberIcon kind="image" /><span class="admin-item-label">Galleryのアルバム管理</span><span class="admin-item-description">アルバムの作成・写真の追加・公開範囲の設定<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
      <li><a href="/Management/blog"><MemberIcon kind="file" /><span class="admin-item-label">Activityのブログ管理</span><span class="admin-item-description">記事の作成・編集・公開<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
    </ul>
  </section>
  <section class="admin-section">
    <h2>企画・通知</h2>
    <ul class="admin-link-list">
      <li><a href="/Member/manage/events/new" aria-label="企画を作成"><MemberIcon kind="plus" /><span class="admin-item-label">企画を作成</span><span class="admin-item-description">撮影会・定例会・その他イベントを準備<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
      <li><a href="/Member/manage/notifications" aria-label="通常のお知らせを送信"><MemberIcon kind="bell" /><span class="admin-item-label">通常のお知らせを送信</span><span class="admin-item-description">宛先を選んでメンバーへ通知<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
      <li><a href="/Member/manage/tools" aria-label="投票・日程調整・目安箱"><MemberIcon kind="file"/><span class="admin-item-label">投票・日程調整・目安箱</span><span class="admin-item-description">メンバーの回答を集めて確認<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
    </ul>
  </section>
  <section class="admin-section">
    <h2>写真展・班分け</h2>
    <ul class="admin-link-list">
      <li><a href="/Member/manage/exhibitions" aria-label="写真展管理"><MemberIcon kind="image" /><span class="admin-item-label">写真展管理</span><span class="admin-item-description">参加投票・フォーム・展示レイアウトを管理<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
      <li><a href="/Member/manage/grouping" aria-label="班分け自動生成ツール"><MemberIcon kind="users" /><span class="admin-item-label">班分け自動生成ツール</span><span class="admin-item-description">参加者と条件を選び、班案を作成・保存<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li>
    </ul>
  </section>
  {!isExecutive(Astro.locals.actor) && !Astro.locals.adminView && <section class="admin-section">
    <h2>表示確認</h2>
    <ul class="admin-link-list"><li><a href="/Management/view"><MemberIcon kind="users" /><span class="admin-item-label">ロールの表示確認</span><span class="admin-item-description">一般会員・未ログインとして閲覧<span class="private-link-arrow" aria-hidden="true"> →</span></span></a></li></ul>
  </section>}
  <section class="admin-section">
    <h2>企画一覧</h2>
    {!events.length && <p>企画はまだありません。</p>}
    <ul class="activity-list">
      {
        events.map((e) => (
          <li>
            <>
              <div class="activity-title-row"><a href={`/Member/manage/events/${e.id}`}>{e.title}</a>{e.status !== "draft" && <ActivityShareButton kind="events" id={e.id} title={e.title} />}</div>
              <small>
                {
                  { draft: "下書き", published: "公開中", cancelled: "中止" }[
                    e.status
                  ]
                }{" "}
                · {activityDate(e.startsAt)} · 担当 {e.ownerName}
              </small>
              {e.status !== "draft" && (
                <div class="activity-actions">
                  <a class="admin-button admin-button-outline" href={`/Member/manage/events/${e.id}?edit=1#activity-event-form`}>企画を編集</a>
                </div>
              )}
            </>
          </li>
        ))
      }
    </ul>
  </section>
  <a class="member-back" href="/Member">メンバーページへ戻る</a>
</StaffLayout>
