---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminAccountRoster from "../../../components/AdminAccountRoster.astro";
import AccountApproval from '../../../components/AccountApproval.astro';
import { canProxyAccount } from '../../../lib/adminViewPolicy.ts';
import { PORTFOLIO_OFFICES, portfolioOffice } from "../../../data/portfolioOffices";
import { getPortfolioDetail, type Portfolio } from "../../../lib/microcms";
import { readUsers, isAdmin, canManageAccount, type User } from "../../../lib/auth";
import { accountDeletionRevision } from "../../../lib/accountDeletion";
import {
  accountRegistration,
  accountRevision,
} from "../../../lib/accountManagement";
import {
  toAdminAccount,
  accountDate,
  type AdminAccount,
} from "../../../lib/adminAccounts";

let account: AdminAccount | null = null;
let unavailable = false;
let registration: ReturnType<typeof accountRegistration> | null = null;
let revision = "";
let deletionRevision = "";
let editable = false;
const administrator = isAdmin(Astro.locals.user);
let approvalTarget: User | undefined;
try {
  const user = readUsers().find((user) => user.id === Astro.params.id);
  if (user) {
    approvalTarget = user;
    editable = canManageAccount(Astro.locals.user, user);
    account = toAdminAccount(user);
    registration = accountRegistration(user);
    revision = accountRevision(user);
    deletionRevision = accountDeletionRevision(user);
  } else Astro.response.status = 404;
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
const portfolioId = administrator ? account?.portfolioId : null;
let currentOffice: string | null = null;
if (portfolioId) {
  try {
    const { role } = await getPortfolioDetail<Pick<Portfolio, "role">>(portfolioId, { fields: "role" });
    currentOffice = role ?? "";
  } catch {
    // The account details remain usable when the linked Portfolio is unavailable.
  }
}
const selectedOffice = portfolioOffice(currentOffice);
---

<AdminLayout
  title="アカウントの登録内容"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "管理画面", href: "/Admin" },
    { label: "アカウント一覧", href: "/Admin/accounts" },
    { label: "登録内容" },
  ]}
>
  <div class="admin-intro"><h2>アカウントの登録内容</h2></div>
  {approvalTarget && <AccountApproval target={approvalTarget} />}
  <section class="admin-section" aria-label="登録内容">
    {
      !account ? (
        <p role="alert">
          {unavailable
            ? "登録内容を取得できませんでした。時間をおいて再読み込みしてください。"
            : "該当するアカウントが見つかりませんでした。"}
        </p>
      ) : (
        <>
          <h3>{account.name}</h3>
          {canProxyAccount(Astro.locals.actor) && !Astro.locals.adminView && <div class="admin-actions"><button class="admin-button" type="button" data-admin-view-account={account.id}>このアカウントでログイン</button><p data-admin-view-status role="status" aria-live="polite"></p></div>}
          {Astro.url.searchParams.get("saved") === "1" && (
            <p role="status">登録内容を保存しました。</p>
          )}
          {portfolioId && (
            <section id="portfolio-office" class="admin-editor-target" aria-labelledby="portfolio-office-title" tabindex="-1">
              <h4 id="portfolio-office-title">Portfolioの役職</h4>
              {currentOffice === null ? (
                <p>連携先のPortfolioから役職を取得できませんでした。</p>
              ) : (
                <form id="portfolio-office-form" data-account-id={account.id} data-portfolio-id={portfolioId} data-current-office={currentOffice}>
                  <div class="admin-field">
                    <label for="portfolio-office-select">掲載する役職</label>
                    <select id="portfolio-office-select" name="office" aria-describedby="portfolio-office-help">
                      <option value="" selected={!selectedOffice}>設定なし</option>
                      {PORTFOLIO_OFFICES.map((office) => (
                        <option value={office} selected={office === selectedOffice}>{office}</option>
                      ))}
                    </select>
                    <small id="portfolio-office-help">役職を設定すると、Portfolioの幹部欄に役職順で掲載されます。ログイン権限は別に設定できます。</small>
                  </div>
                  <button type="submit" class="admin-button" disabled>役職を保存</button>
                  <p role="status" aria-live="polite"></p>
                </form>
              )}
            </section>
          )}
          {editable && <details class="admin-account-editor">
            <summary>登録内容を編集</summary>
            <form
              id="account-editor"
              data-account-id={account.id}
              data-revision={revision}
            >
              <fieldset>
                <legend class="visually-hidden">登録内容の編集</legend>
                <div class="admin-field">
                  <label for="account-name">アカウント名</label>
                  <input
                    id="account-name"
                    name="name"
                    type="text"
                    required
                    maxlength="80"
                    value={registration!.name}
                    aria-describedby="account-name-help"
                  />
                  <small id="account-name-help">
                    ログイン時の挨拶に表示される名前です。
                  </small>
                </div>
                <div class="admin-field">
                  <label for="account-email">メールアドレス</label>
                  <input
                    id="account-email"
                    name="email"
                    type="email"
                    required
                    maxlength="254"
                    value={registration!.email}
                    aria-describedby="account-email-help"
                  />
                  <small id="account-email-help">
                    変更後は新しいメールアドレスでログインします。変更すると本人のログイン状態と発行済みのパスワード再設定リンクが無効になります。
                  </small>
                </div>
                <div class="admin-field">
                  <label for="account-role">権限</label>
                  <select
                    id="account-role"
                    name="role"
                    required
                    aria-describedby="account-role-help"
                  >
                    <option
                      value="member"
                      selected={registration!.role === "member"}
                    >
                      一般会員
                    </option>
                    <option
                      value="staff"
                      selected={registration!.role === "staff"}
                    >
                      運営
                    </option>
                    {administrator && <option value="executive" selected={registration!.role === "executive"}>幹部</option>}
                    {administrator && <option
                      value="admin"
                      selected={registration!.role === "admin"}
                    >
                      管理者
                    </option>}
                  </select>
                  <small id="account-role-help">
                    運営は通知・企画・参加者・班分けを管理できます。幹部は加えて一般会員・運営のアカウント、名簿と全写真のいいね数を管理できます。幹部・管理者への権限変更は管理者が行います。権限変更後は本人の再ログインが必要です。最後の承認済み管理者は降格できません。
                  </small>
                </div>
                <div class="admin-field">
                  <label for="account-portfolio-name">
                    登録時のPortfolio名
                  </label>
                  <input
                    id="account-portfolio-name"
                    name="portfolioName"
                    type="text"
                    maxlength="50"
                    value={registration!.portfolioName}
                    aria-describedby="account-portfolio-help"
                  />
                  <small id="account-portfolio-help">
                    登録情報の記録を修正します。{administrator ? "公開ページの名前は、アカウント一覧の「Portfolioを編集」から変更してください。" : "公開ページの名前の変更は管理者が行います。"}記録がない場合は空欄にできます。
                  </small>
                </div>
              </fieldset>
              <button class="admin-button" type="submit" disabled>
                登録内容を保存
              </button>
              <p id="account-editor-status" role="status" aria-live="polite" />
              <noscript>
                <p>編集にはJavaScriptを有効にしてください。</p>
              </noscript>
            </form>
          </details>}
          <dl class="admin-account-details">
            <div>
              <>
                <dt>アカウント名</dt>
                <dd>{account.name}</dd>
              </>
            </div>
            <div>
              <>
                <dt>メールアドレス</dt>
                <dd>{account.email}</dd>
              </>
            </div>
            <div>
              <>
                <dt>権限</dt>
                <dd>{account.role}</dd>
              </>
            </div>
            <div>
              <>
                <dt>承認状態</dt>
                <dd data-account-approval-state>
                  <span data-account-approval-label>{account.status}</span>
                  {!account.approved && (
                    <small>未承認には承認待ち・承認の取消を含みます。</small>
                  )}
                </dd>
              </>
            </div>
            <div>
              <>
                <dt>登録日時（日本時間）</dt>
                <dd>{accountDate(account.createdAt)}</dd>
              </>
            </div>
            <div>
              <>
                <dt>承認通知日時（日本時間）</dt>
                <dd data-account-approval-notified>{accountDate(account.approvalNotifiedAt)}</dd>
              </>
            </div>
            {account.approvalSetupStatus && (
              <div>
                <dt>承認後の初期設定</dt>
                <dd>{account.approvalSetupStatus}</dd>
              </div>
            )}
            <div>
              <>
                <dt>登録時のPortfolio名</dt>
                <dd>
                  {account.portfolioName}
                  <small>
                    登録時の記録です。現在の表示名はPortfolioで確認できます。
                  </small>
                </dd>
              </>
            </div>
            <div>
              <>
                <dt>Portfolio ID</dt>
                <dd>{account.portfolioId ?? "未連携"}</dd>
              </>
            </div>
            <div>
              <>
                <dt>メール・パスワードでのログイン</dt>
                <dd>{account.credentials ? "登録あり" : "登録なし"}</dd>
              </>
            </div>
            <div>
              <>
                <dt>Instagram連携</dt>
                <dd>
                  {account.instagramLinked ? "連携あり" : "未連携"}
                  {account.instagramUsername && (
                    <small>@{account.instagramUsername}</small>
                  )}
                </dd>
              </>
            </div>
            <div>
              <>
                <dt>アカウントID</dt>
                <dd>{account.id}</dd>
              </>
            </div>
            <AdminAccountRoster accountId={account.id} />
          </dl>
          {editable && <div class="admin-account-delete">
            <h3>アカウントの削除</h3>
            {account.id === Astro.locals.user?.id ? (
              <p>ログイン中の管理者自身は削除できません。</p>
            ) : (
              <>
                <p>
                  アカウントと紐づくPortfolioページ（プロフィール・掲載写真）を削除します。この画面から元に戻すことはできません。
                </p>
                <button
                  id="account-delete-open"
                  type="button"
                  aria-haspopup="dialog"
                  aria-controls="account-delete-dialog"
                  disabled
                >
                  アカウントを削除
                </button>
                <noscript>
                  <p>削除操作にはJavaScriptを有効にしてください。</p>
                </noscript>
                <dialog
                  class="admin-dialog"
                  id="account-delete-dialog"
                  aria-labelledby="account-delete-title"
                  aria-describedby="account-delete-description"
                >
                  <h2 id="account-delete-title">アカウントの削除確認</h2>
                  <p id="account-delete-description">
                    次のアカウントとPortfolioを削除します。対象を確認してください。
                  </p>
                  <dl class="admin-delete-target">
                    <dt>アカウント名</dt>
                    <dd>{account.name}</dd>
                    <dt>メールアドレス</dt>
                    <dd>{account.email}</dd>
                    <dt>Portfolio ID</dt>
                    <dd>
                      {account.portfolioId ?? "未連携（アカウントのみ削除）"}
                    </dd>
                  </dl>
                  <p class="admin-help">
                    ログイン状態とパスワード再設定リンクも無効になります。画像ファイル自体は他のページで使われる可能性があるため、microCMSのメディアに残ります。
                  </p>
                  <form
                    id="account-delete-form"
                    class="admin-delete-form"
                    data-account-id={account.id}
                    data-revision={deletionRevision}
                    data-email={account.email}
                  >
                    <div class="admin-field">
                      <label for="account-delete-email">
                        確認用のメールアドレス
                      </label>
                      <input
                        id="account-delete-email"
                        name="confirmationEmail"
                        type="email"
                        required
                        maxlength="254"
                        autocomplete="off"
                        autocapitalize="none"
                        spellcheck="false"
                      />
                    </div>
                    <p
                      id="account-delete-status"
                      role="status"
                      aria-live="polite"
                    />
                    <div class="admin-actions">
                      <button
                        id="account-delete-cancel"
                        type="button"
                        autofocus
                      >
                        キャンセル
                      </button>
                      <button
                        id="account-delete-submit"
                        class="admin-button"
                        type="submit"
                        disabled
                      >
                        削除を確定する
                      </button>
                    </div>
                  </form>
                </dialog>
              </>
            )}
          </div>}
        </>
      )
    }
    <div class="admin-actions">
      <a href="/Admin/accounts">アカウント一覧へ戻る</a>
    </div>
  </section>
</AdminLayout>

<script>
  import "../../../scripts/accountEditor";
  import "../../../scripts/accountDeletion";
  import { apiErrorMessage, readApiResponse } from "../../../scripts/apiResponse";
  import { operationNotice } from "../../../scripts/siteNotice";

  const form = document.querySelector<HTMLFormElement>("#portfolio-office-form");
  if (form) {
    const select = form.querySelector("select")!;
    const button = form.querySelector("button")!;
    const status = form.querySelector('[role="status"]')!;
    const notify = (message: string, error = false) => {
      status.textContent = message;
      operationNotice(message, error, "portfolio-office");
    };
    button.disabled = false;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      const office = select.value;
      select.disabled = button.disabled = true;
      notify("保存しています…");
      try {
        const response = await fetch(
          `/api/admin/accounts/${encodeURIComponent(form.dataset.accountId!)}/portfolio-office`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              portfolioId: form.dataset.portfolioId,
              previousOffice: form.dataset.currentOffice,
              office,
            }),
          },
        );
        const result = await readApiResponse(response);
        if (!response.ok || !result.ok) throw new Error(result.message);
        form.dataset.currentOffice = office;
        notify("Portfolioの役職を保存しました。");
      } catch (error) {
        notify(apiErrorMessage(error, "役職を保存できませんでした。"), true);
      } finally {
        select.disabled = button.disabled = false;
      }
    });
  }
</script>
