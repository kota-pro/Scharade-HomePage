---
import PageTopNav from "../components/PageTopNav.astro";
import '../styles/UA+reset.css';
import Layout from "../layouts/Layout.astro";
import {getContent} from "../lib/siteContent";
const sections=getContent("disclaimer",Astro.locals.preview).sections;
const subheadings = new Set([
    "個人情報の取得と利用",
    "写真・プロフィールの公開範囲",
    "外部サービスと情報の管理",
    "Cookie・アクセス情報",
    "個人情報に関するお問い合わせ",
    // Keep existing saved content readable in the editor's preview and restore flow.
    "個人情報の利用",
    "アクセス解析ツールについて",
    "コメントについて",
]);
const paragraphs = (text: string) => text.split(/\n\s*\n/).map(part => part.trim()).filter(Boolean);
const links = new Map([
    ["Contact", "/Contact"],
    ["アカウント削除の申請ページ", "/AccountDeletion"],
    ["アプリのプライバシーポリシー", "/AppPrivacy"],
]);
const linkedText = (text: string) => text.split(/(Contact|アカウント削除の申請ページ|アプリのプライバシーポリシー)/g)
    .map(text => ({ text, href: links.get(text) }));
---

<Layout description="写団シャレード公式サイトの個人情報の取扱い、写真・作品の著作権、免責事項、リンクについてご案内します。">
<Fragment slot="main-slot">
    <div class = "section-title"> 
        <h1>Disclaimer</h1>
        <div class = "section-title-line"></div>
    </div>
</Fragment>
<Fragment slot="menu-slot">
    <div class="menu-contents-inner">
        <PageTopNav />
    </div>
</Fragment>
<Fragment slot="body-slot">
    {sections.map((section, index) => (
        <section class="disclaim_container" aria-labelledby={`disclaimer-section-${index}`}>
            <h2 id={`disclaimer-section-${index}`}>{section.title}</h2>
            {paragraphs(section.text).map(text => subheadings.has(text)
                ? <h3>{text}</h3>
                : <p>{text.split("\n").map((line, i) => <>{i > 0 && <br />}{linkedText(line).map(part => part.href
                    ? <a class="href-anchor" href={part.href}>{part.text}</a>
                    : part.text)}</>)}</p>
            )}
        </section>
    ))}
    <section class="disclaim_container" aria-labelledby="disclaimer-error-reports">
        <h2 id="disclaimer-error-reports">エラーの自動報告</h2>
        <p>障害の調査と改善のため、エラー番号、発生日時、ページの種類、ブラウザー・端末の種類、通信や文字表示の失敗状況を運営窓口へ自動報告します。入力した文章・氏名・メールアドレス・写真・パスワード・確認コード・Cookieは報告に含めません。URLの識別情報や検索条件も除いて送信します。</p>
        <p>サイト内の送信待ちは最大7日間、送信済みの通知記録は24時間を目安に保持します。運営窓口に届いたメールは障害調査に使用します。<a class="href-anchor" href="/Errors">エラー番号の案内</a>も参照してください。</p>
    </section>
</Fragment>
</Layout>

<style>
    .section-title {
        display: flex;
        flex-direction: row;
        align-items: space-between;
        justify-content: center;
        margin-bottom: 55px;
        margin-top:25px;
    }

    .section-title h1{
        color:#000;
        font-family: "linotype-didot", serif;
        font-size:96px;
        font-style:normal;
        font-weight:400;
        line-height:normal;
        letter-spacing: 14.4px;
        padding-right: 78px;
    }

    .section-title-line{
        width :100%;
        position:relative;
    }

    .section-title-line::after{
        content:"";
        display:block;
        width:100%;
        height:1px;
        background:#000;
        position:absolute;
        top:50%;
        right:0;
    }

    .menu-contents-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
    }

    .disclaim_container {
        display:flex;
        width: 100%;
        box-sizing: border-box;
        min-width: 0;
        padding-left: 20px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        position: relative;
        margin-top: 15px;
        margin-bottom: 15px;
    }

    .disclaim_container:not(:last-child){
        margin-bottom: 60px;
    }

    .disclaim_container::after{
        content:'';
        display:block;
        width:1px;
        height: calc(100% + 30px);
        background:#000;
        position: absolute;
        top: -15px;
        left: 0;
    }

    .disclaim_container h2{
        color:#000;
        font-family:YakuHanMP, "Zen Old Mincho", serif;
        font-size:32px;
        font-style:normal;
        font-weight: 400;
        line-height:1.6;
        letter-spacing: 4.8px;
        margin-bottom: 40px;
    }

    .disclaim_container h3{
        color:#000;
        font-family:YakuHanRP, "Zen Kurenaido", sans-serif;
        font-size:20px;
        font-style:normal;
        font-weight:400;
        line-height:1.7;
        letter-spacing: 3px;
        margin-bottom:15px;
    }

    .disclaim_container p + h3 {
        margin-top: 24px;
    }

    .disclaim_container p{
        color: #000;
        font-family: YakuHanRP, "Zen Kurenaido", sans-serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 1.9;
        letter-spacing: 2.4px;
        overflow-wrap: anywhere;
    }

    .disclaim_container p:not(:last-child) {
        margin-bottom: 15px;
    }

    .disclaim_container a {
        position: relative;
        cursor: pointer;
    }

    .disclaim_container a::after {
        position: absolute;
        left: 0px;
        right: 0px;
        content: '';
        width: 100%;
        height: 1px;
        background: #000000;
        bottom: 0px;
        transform: scale(0, 1);
        transform-origin: center top;
        transition: transform 0.3s;
    }

    .disclaim_container a:is(:hover, :focus-visible)::after {
        transform: scale(1, 1);
    }

    .disclaim_container a:focus-visible {
        outline: 1px solid currentColor;
        outline-offset: 3px;
    }

    @media (max-width: 768px) {
        .menu {
            top: 150px;
        }

        .section-title {
            margin-bottom: 35px;
        }

        .section-title h1 {
            font-size: 48px;
            letter-spacing: 7.2px;
            padding-right: 16px;
        }

        .disclaim_container {
            padding-left: 15px;
            margin-top: 12px;
            margin-bottom: 12px;
        }

        .disclaim_container::after {
            height: calc(100% + 24px);
            top: -12px;
        }

        .disclaim_container h2 {
            font-size: 25px;
            letter-spacing: 3px;
            margin-bottom: 24px;
        }

        .disclaim_container h3 {
            font-size: 20px;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .disclaim_container p {
            font-size: 14px;
            letter-spacing: 1.6px;
            line-height: 1.7;
        }

        .disclaim_container p:not(:last-child) {
            margin-bottom: 12px;
        }
    }
</style>

<style>@media (max-width:360px) {.section-title h1 {font-size:clamp(42px,14vw,48px);}}</style>
