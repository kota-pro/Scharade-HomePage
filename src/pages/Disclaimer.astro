---
import PageTopNav from "../components/PageTopNav.astro";
import '../styles/UA+reset.css';
import Layout from "../layouts/Layout.astro";
import {getContent} from "../lib/siteContent";
const sections=getContent("disclaimer",Astro.locals.preview).sections;
const subheadings=["個人情報の利用","アクセス解析ツールについて","コメントについて"];
const paragraphs=(text:string) => { const result:{heading?:string;text:string}[]=[]; for(const part of text.split("\n\n")){if(subheadings.includes(part))result.push({heading:part,text:""});else if(result.length)result[result.length-1].text+=(result[result.length-1].text ? "\n" : "")+part;else result.push({text:part});}return result;};
---

<Layout>
<Fragment slot="main-slot">
    <div class = "section-title"> 
        <h1>Disclaimer</h1>
        <div class = "section-title-line"></div>
    </div>
</Fragment>
<Fragment slot="menu-slot">
    <div class="menu-contents-inner">
        <PageTopNav />
    </div>
</Fragment>
<Fragment slot="body-slot">
    {sections.map(section => <div class="disclaim_container"><h1>{section.title}</h1>{paragraphs(section.text).map(block => <>{block.heading && <h2>{block.heading}</h2>}<p>{block.text.split("\n").map((line,i) => <>{i>0 && <br/>}{line}</>)}</p></>)}</div>)}
</Fragment>
</Layout>

<style>
    .section-title {
        display: flex;
        flex-direction: row;
        align-items: space-between;
        justify-content: center;
        margin-bottom: 55px;
        margin-top:25px;
    }

    .section-title h1{
        color:#000;
        font-family: "linotype-didot", serif;
        font-size:96px;
        font-style:normal;
        font-weight:400;
        line-height:normal;
        letter-spacing: 14.4px;
        padding-right: 78px;
    }

    .section-title-line{
        width :100%;
        position:relative;
    }

    .section-title-line::after{
        content:"";
        display:block;
        width:100%;
        height:1px;
        background:#000;
        position:absolute;
        top:50%;
        right:0;
    }

    .menu-contents-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
    }

    .disclaim_container {
        display:flex;
        height: 100%;
        width: 100%;
        padding-left: 20px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        position: relative;
        margin-top: 15px;
        margin-bottom: 15px;
    }

    .disclaim_container:not(:last-child){
        margin-bottom: 60px;
    }

    .disclaim_container::after{
        content:'';
        display:block;
        width:1px;
        height: calc(100% + 30px);
        background:#000;
        position: absolute;
        top: -15px;
        left: 0;
    }

    .disclaim_container h1{
        color:#000;
        font-family:"Zen Old Mincho", serif;
        font-size:32px;
        font-style:normal;
        font-weight: 400;
        line-height:normal;
        letter-spacing: 4.8px;
        margin-bottom: 40px;
    }

    .disclaim_container h2{
        color:#000;
        font-family:"Zen Kurenaido", sans-serif;
        font-size:20px;
        font-style:normal;
        font-weight:400;
        line-height:normal;
        letter-spacing: 3px;
        margin-bottom:15px;
    }

    .disclaim_container p{
        color: #000;
        font-family: "Zen Kurenaido", sans-serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2.4px;
    }

    .disclaim_container p:not(:last-child) {
        margin-bottom: 15px;
    }

    .disclaim_container a {
        position: relative;
        cursor: pointer;
    }

    .disclaim_container a::after {
        position: absolute;
        left: 0px;
        right: 0px;
        content: '';
        width: calc(100% - 30px);
        height: 1px;
        background: #000000;
        bottom: 0px;
        transform: scale(0, 1);
        transform-origin: center top;
        transition: transform 0.3s;
    }

    .disclaim_container a:hover::after {
        transform: scale(1, 1);
    }

    @media (max-width: 768px) {
        .menu {
            top: 150px;
        }

        .section-title {
            margin-bottom: 35px;
        }

        .section-title h1 {
            font-size: 48px;
            letter-spacing: 7.2px;
            padding-right: 16px;
        }

        .disclaim_container {
            padding-left: 15px;
            margin-top: 12px;
            margin-bottom: 12px;
        }

        .disclaim_container::after {
            height: calc(100% + 24px);
            top: -12px;
        }

        .disclaim_container h1 {
            font-size: 25px;
            letter-spacing: 3px;
            margin-bottom: 24px;
        }

        .disclaim_container h2 {
            font-size: 20px;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .disclaim_container p {
            font-size: 14px;
            letter-spacing: 1.6px;
            line-height: 1.7;
        }

        .disclaim_container p:not(:last-child) {
            margin-bottom: 12px;
        }
    }
</style>

<style>@media (max-width:360px) {.section-title h1 {font-size:clamp(42px,14vw,48px);}}</style>
