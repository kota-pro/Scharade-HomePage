---
import PageTopNav from "../components/PageTopNav.astro";
import PopupCloseButton from "../components/PopupCloseButton.astro";
import '../styles/UA+reset.css';
import Layout from '../layouts/Layout.astro';
import {getContent} from '../lib/siteContent';
---
<Layout>
<Fragment slot="main-slot">
    <div class = "section-title a-anchor"> 
        <h1>Contact</h1>
        <div class = "section-title-line"></div>
    </div>
</Fragment>
<Fragment slot="menu-slot">
    <div class="menu-contents-inner">
        <PageTopNav />
    </div>
</Fragment>
<Fragment slot="body-slot">
    <p class="contact-description">{getContent("contact",Astro.locals.preview).introduction.split("\n").map((line,i) => <>{i > 0 && <br/>}{line}</>)}</p>
    <div class="contact-form">
        <form class="form" id="contact-form">
            <table class="form-table">
                <tbody>
                    <tr>
                        <th><p id="name" class="a-anchor">お名前</p></th>
                        <td class="require-td"><p id="require">必須</p></td>
                        <td class="input-td"><input type="text" name="name" maxlength="80" aria-label="お名前" autocomplete="name" required></td>
                    </tr>
                    <tr>
                        <th><p id="furigana" class="a-anchor">フリガナ</p></th>
                        <td class="require-td"><p id="require">必須</p></td>
                        <td class="input-td"><input type="text" name="furigana" maxlength="100" aria-label="フリガナ" autocomplete="off" id="inputField" required></td>
                    </tr>
                    <tr>
                        <th><p id="institution" class="a-anchor">所属教育機関</p></th>
                        <td class="require-td"><p id="require">必須</p></td>
                        <td class="input-td"><input type="text" placeholder="※学生でない方は所属企業名をお書きください。" name="institution" maxlength="200" aria-label="所属教育機関" autocomplete="organization" required></td>
                    </tr>
                    <tr>
                        <th><p id="faculty" class="a-anchor">学部</p></th>
                        <td class="require-td"></td>
                        <td class="input-td"><input type="text" name="faculty" maxlength="100" aria-label="学部"></td>
                    </tr>
                    <tr>
                        <th><p id="grade" class="a-anchor">学年</p></th>
                        <td class="require-td"><p id="require">必須</p></td>
                        <td class="input-td">
                            <span><input class="grade-selection" type="radio" value="1年" name="grade" id="grade-1" required><label for="grade-1">1年</label></span>
                            <span><input class="grade-selection" type="radio" value="2年" name="grade" id="grade-2"><label for="grade-2">2年</label></span>
                            <span><input class="grade-selection" type="radio" value="3年" name="grade" id="grade-3"><label for="grade-3">3年</label></span>
                            <span><input class="grade-selection" type="radio" value="4年" name="grade" id="grade-4"><label for="grade-4">4年</label></span>

                            <span><input class="grade-selection" type="radio" value="院生" name="grade" id="grade-5"><label for="grade-5">院生</label></span>
                            <span><input class="grade-selection" type="radio" value="留学生" name="grade" id="grade-6"><label for="grade-6">留学生</label></span>
                            <span><input class="grade-selection" type="radio" value="その他" name="grade" id="grade-7"><label for="grade-7">その他</label></span>
                        </td>
                    </tr>
                    <tr>
                        <th><p id="email" class="a-anchor">メールアドレス</p></th>
                        <td class="require-td"><p id="require">必須</p></td>
                        <td class="input-td"><input type="email" name="email" maxlength="254" aria-label="メールアドレス" autocomplete="email" required></td>
                    </tr>
                    <tr>
                        <th><p id="inquiry" class="a-anchor">お問い合わせ内容</p></th>
                        <td class="require-td"><p id="require">必須</p></td>
                        <td class="input-td">
                            <span><input class="inquiry-selection" type="radio" value="入会希望" name="inquiry" required id="inquiry-1"><label for="inquiry-1">入会希望</label></span>
                            <span><input class="inquiry-selection" type="radio" value="見学・体験希望" name="inquiry" required id="inquiry-2"><label for="inquiry-2">見学・体験希望</label></span>
                            <span><input class="inquiry-selection" type="radio" value="撮影依頼" name="inquiry" required id="inquiry-3"><label for="inquiry-3">撮影依頼</label></span>
                            <span><input class="inquiry-selection" type="radio" value="その他" name="inquiry" required id="inquiry-4"><label for="inquiry-4">その他</label></span>
                        </td>
                    </tr>
                    <tr>
                        <th><p id="message" class="a-anchor">お問い合わせ詳細</p></th>
                        <td class="require-td"></td>
                        <td class="text-td"><textarea name="message" maxlength="5000" aria-label="お問い合わせ詳細" rows="8" placeholder="※上記で「その他」を選択した方は内容をこちらにお書きください。"></textarea></td>
                    </tr>
                </tbody>
            </table>
            <div class="button-div-1">
                <div class = "section-title-line-1"></div>
                <button type="submit" class="confirm-button">Confirm</button>
                <div class = "section-title-line-2"></div>
            </div>
            <div class="confirm-preview is-hidden" id="contact-preview" role="dialog" aria-modal="true" aria-label="Confirm">
                <div class="preview-header">
                    <h1>Confirm</h1>
                    <PopupCloseButton id="close-preview" label="戻って編集" />
                </div>
                <div class="preview-body">
                    <div class="preview-item-left">
                        <span>
                            <h2 class="preview-item-title">お名前</h2>
                            <p class="preview-item-content" id="preview-name"></p>
                        </span>
                        <span>
                            <h2 class="preview-item-title">フリガナ</h2>
                            <p class="preview-item-content" id="preview-furigana"></p>
                        </span>
                        <span>
                            <h2 class="preview-item-title">所属教育機関</h2>
                            <p class="preview-item-content" id="preview-institution"></p>
                        </span>
                        <span>
                            <h2 class="preview-item-title">学部</h2>
                            <p class="preview-item-content" id="preview-faculty"></p>
                        </span>
                        <span>
                            <h2 class="preview-item-title">学年</h2>
                            <p class="preview-item-content" id="preview-grade"></p>
                        </span>
                        <span>
                            <h2 class="preview-item-title">メールアドレス</h2>
                            <p class="preview-item-content" id="preview-email"></p>
                        </span>
                        <span>
                            <h2 class="preview-item-title">お問い合わせ内容</h2>
                            <p class="preview-item-content" id="preview-inquiry"></p>
                        </span>
                    </div>
                    <div class="preview-item-right">
                        <h2 class="preview-item-title">お問い合わせ詳細</h2>
                        <div class="preview-message-container">
                            <p class="preview-item-content" id="preview-message"></p>
                        </div>
                    </div>                    
                </div>
                <div class="button-div-2">
                    <button type="button" class="submit-button" id="contact-send">Submit</button><p class="send-status" role="status"></p>
                </div>
            </div>
            <div class="mask is-hidden"></div><p id="contact-result" role="status"></p>
        </form>
    </div>
</Fragment>
</Layout>

<script>import "../scripts/contact";</script>

<style>
    .a-anchor {
        padding-top: 150px;
        margin-top: -150px;
    }

    .menu-contents-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
    }
    .section-title {
        display: flex;
        flex-direction: row;
        align-items: space-between;
        justify-content: center;
        margin-bottom: 55px;
    }

    .section-title  h1{
        color: #000;
        font-family: "linotype-didot", serif;
        font-size: 96px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 14.4px;
        padding-right: 78px;
    }

    .section-title-line,
    .section-title-line-1,
    .section-title-line-2 {
        width: 100%;
        position: relative;
    }

    .section-title-line::after,
    .section-title-line-1::after,  
    .section-title-line-2::after {
        content: '';
        display: block;
        height: 1px;
        background: #000;
        position: absolute;
        top: 50%;
    }

    .section-title-line::after {
        width: 100%;
        right: 0;
    }

    .section-title-line-1::after {
        width: calc(100% + 140px);
        left: -140px;
    }
    .section-title-line-2::after {
        width: calc(100% + 140px);
        right: -140px;
    }

    .contact-description {
        color: #000;
        font-family: YakuHanRP, "Zen Kurenaido";
        font-size: 20px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 3px;
    }

    .contact-form {
        margin-top: 45px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .form {
            width: 100%;
            max-width: 920px;
            display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .form p , .input-td label {
        color: #000;
        font-family: "Zen Kurenaido";
        font-size: 20px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 3px;
    }

    .form-table {
        width: 100%;
        border-collapse: collapse;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .form-table tbody{
        width: 100%;
    }

    .form-table tr {
        width: 100%;
        margin: 40px 0;
        display: flex;
        align-items: center;
    }

    .form-table tr:last-of-type > th{
        align-items: flex-start !important;
        height: -webkit-fill-available;
        height: stretch;
    }

    .form-table th {
        text-align: left;
        flex: 2;
    }

    .require-td {
        text-align: center;
        flex: 1;
    }

    .input-td {
        height: 50px;
        flex: 6;
        display: flex;
        align-items: center;
        justify-content: space-around;
    }

    .text-td {
        flex: 6;
        height: 200px;
    }

    .text-td textarea {
        width: 100%;
        height: 100%;
        border-radius: 5px;
        resize: none;
    }

    #require {
        color: #ff7979;
        font-family: "Zen Kurenaido";
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2.1px;
    }

    input[type="text"], input[type="email"], textarea {
        width: 100%;
        height: 100%;
        border-radius: 5px;
        border: 1px solid #909090;
        background: #FFF;
        padding: 10px 12px;
    }

    input[name="institution" maxlength="200" aria-label="所属教育機関"]::placeholder,
    textarea::placeholder {
        color: #909090;
        font-family: "Zen Kurenaido";
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2.1px;
    }

    .input-td span {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .button-div-1 {
        width: 100%;
        height: 100%;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .confirm-button {
        display: inline-block;
        padding: 14px 32px 16px;
        background-color: #ffffff;
        color: #000000;
        text-decoration: none;
        font-family: "Zen Old Mincho";
        font-size: 20px;
        letter-spacing: 3px;
        border: #000000 1px solid;
        cursor: pointer;
        margin: 0 78px;
    }

    .confirm-button:hover,
    .submit-button:hover {
        background-color: #707070;
        color: #ffffff;
        transition: 0.3s ease-in-out;
    }

    .confirm-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 83vw;
        height: 80vh;
        background-color: #ffffff;
        border: 1px solid #000000;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        z-index: 1000 !important;
        padding: 24px 40px;
    }

    .is-hidden {
        display: none !important;
    }

    .preview-header {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        margin-bottom: 55px;
    }

    .preview-header::after {
        position: absolute;
        content: '';
        background: #000;
        width: 43%;
        height: 1px;
        bottom: 0;
        left: -15px;
    }

    .preview-header h1 {
        color: #000;
        font-family: "linotype-didot", serif;
        font-size: 40px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 6px;
        cursor: default;
    }

    .preview-body {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        flex-grow: 1;
        overflow-y: hidden;
    }

    .preview-item-title {
        color: #000;
        font-family: "Zen Old Mincho";
        font-size: 20px;
        font-style: normal;
        font-weight: 500;
        line-height: normal;
        letter-spacing: 3px;
        cursor: default;
    }

    .preview-item-content {
        color: #000;
        font-family: YakuHanRP, "Zen Kurenaido";
        font-size: 18px !important;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2.7px !important;
    }

    .preview-item-left {
        width: 49%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .preview-item-left span {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: flex-start;
    }

    .preview-item-left h2 {
        width: 40%;
    }

    .preview-item-left p {
        width: 60%;
        height: -webkit-fill-available;
        height: stretch;
        padding: 0px 4px 2px;
        border-bottom: 1px solid #f0f0f0;
        position: relative;
    }

    .preview-item-left p::after {
        position: absolute;
        content: '';
        width: 16px;
        height: 16px;
        background-image: url('../../public/icons/editable.svg');
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center;
        right: 4px;
        top: calc(50% - 8px);
        filter: invert(100%) sepia(56%) saturate(104%) hue-rotate(198deg) brightness(113%) contrast(88%);
    }

    .preview-item-left p:hover {
        border-bottom: 1px solid #0db49b;
        color: #0db49b;
        cursor: pointer;
    }

    .preview-item-left p:hover::after {
        filter: invert(53%) sepia(100%) saturate(357%) hue-rotate(121deg) brightness(87%) contrast(101%);
    }

    .preview-item-right {
        width: 49%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
    }

    .preview-item-right h2{
        margin-bottom: 30px;
    }

    .preview-message-container {
        width: 100%;
        height: -webkit-fill-available;
        height: stretch;
        box-sizing: border-box;
        overflow-y: auto;
        padding: 6px 10px;
        border: 1px solid #f0f0f0;
        user-select: none;
    }

    .preview-message-container p {
        display: block;
        width: 100%;
        height: -webkit-fill-available;
        height: stretch;
        white-space: pre-wrap;
    }

    .preview-message-container::after {
        position: fixed;
        display: block;
        content: '';
        width: 16px;
        height: 16px;
        background-image: url('../../public/icons/editable.svg');
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center;
        right: 44px;
        bottom: 127px;
        filter: invert(100%) sepia(56%) saturate(104%) hue-rotate(198deg) brightness(113%) contrast(88%);
    }

    .preview-message-container:hover {
        border: 1px solid #0db49b;
        cursor: pointer;
    }

    .preview-message-container:hover p {
        color: #0db49b;
    }

    .preview-message-container:hover::after {
        filter: invert(53%) sepia(100%) saturate(357%) hue-rotate(121deg) brightness(87%) contrast(101%);
    }

    .button-div-2 {
        width: 100%;
        margin-top: 38px;
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
    }

    .submit-button {
        display: inline-block;
        padding: 14px 32px 16px;
        background-color: #ffffff;
        color: #000000;
        text-decoration: none;
        font-family: "Zen Old Mincho";
        font-size: 20px;
        letter-spacing: 3px;
        border: #000000 1px solid;
        cursor: pointer;
    }

    .mask {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000;
        opacity: .8;
        z-index: 999 !important;
        cursor: pointer;
        transition: all .5s;
    }

    @media (max-width: 1024px) {
        .section-title {
            margin-bottom: 35px;
        }

        .section-title h1 {
            font-size: 60px;
            letter-spacing: 5px;
            padding-right: 28px;
        }

        .contact-description {
            font-size: 16px;
            letter-spacing: 1.8px;
            line-height: 1.8;
        }

        .contact-form {
            margin-top: 0px;
        }

        .form {
            max-width: 100%;
        }

        .form p,
        .input-td label {
            font-size: 16px;
            letter-spacing: 1.8px;
        }

        .form-table tr {
            margin: 20px 0;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .form-table th,
        .require-td,
        .input-td,
        .text-td {
            flex: none;
            width: 100%;
        }

        .require-td {
            text-align: left;
        }

        .form-table th p {
            display: inline-block;
        }

        .input-td {
            height: auto;
            justify-content: flex-start;
            flex-wrap: wrap;
            gap: 10px;
        }

        .input-td span {
            width: 100%;
            position: relative;
            justify-content: flex-start;
        }

        .input-td span input[type="radio"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            margin: 0;
            cursor: pointer;
        }

        .input-td span label {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #909090;
            border-radius: 5px;
            background: #fff;
            text-align: center;
            transition: all 0.2s ease;
        }

        .input-td span input[type="radio"]:checked + label {
            color: #0db49b;
            border-color: #0db49b;
        }

        .form-table tr:nth-of-type(5) .input-td,
        .form-table tr:nth-of-type(7) .input-td {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .text-td {
            height: 160px;
        }

        .button-div-1 {
            margin-top: 20px;
        }

        .section-title-line-1::after {
            left: 0;
            width: 100%;
        }

        .section-title-line-2::after {
            right: 0;
            width: 100%;
        }

        .confirm-button,
        .submit-button {
            padding: 12px 24px 14px;
            font-size: 16px;
            letter-spacing: 2px;
        }

        .confirm-preview {
            inset: 0;
            top: 0;
            left: 0;
            transform: none;
            width: 100vw;
            height: 100dvh;
            border: none;
            border-radius: 0;
            padding: calc(18px + env(safe-area-inset-top)) 16px calc(18px + env(safe-area-inset-bottom));
        }

        .preview-header {
            margin-bottom: 28px;
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
            padding-bottom: 14px;
        }

        .preview-header::after {
            width: 100%;
            left: 0;
        }

        .preview-header h1 {
            font-size: 30px;
            letter-spacing: 4px;
        }

        .preview-body {
            flex-direction: column;
            gap: 18px;
            overflow-y: auto;
            padding-bottom: 8px;
        }

        .preview-item-left,
        .preview-item-right {
            width: 100%;
        }

        .preview-item-left {
            gap: 14px;
        }

        .preview-item-left span {
            flex-direction: column;
            gap: 4px;
            padding: 10px 0px;
        }

        .preview-item-left h2,
        .preview-item-left p {
            width: 100%;
        }

        .preview-item-title {
            font-size: 16px;
            letter-spacing: 2px;
        }

        .preview-item-content {
            font-size: 14px !important;
            letter-spacing: 1.4px !important;
        }

        .preview-item-right h2 {
            margin-bottom: 12px;
        }

        .form-table tr:nth-of-type(5) .input-td span:nth-last-child(1) {
            grid-column: span 2;
        }
        .preview-message-container {
            min-height: 120px;
        }

        .preview-message-container::after {
            right: 22px;
            bottom: 104px;
        }

        .button-div-2 {
            margin-top: 20px;
            justify-content: center;
            padding-bottom: calc(4px + env(safe-area-inset-bottom));
        }
    }

    @media (max-width: 428px) {
        .section-title h1 {
            font-size: 46px;
            letter-spacing: 4px;
            padding-right: 18px;
        }

        .contact-description {
            font-size: 14px;
            letter-spacing: 1.4px;
            line-height: 1.75;
        }

        .form p,
        .input-td label,
        #require {
            font-size: 13px;
            letter-spacing: 1px;
        }

        .form-table tr {
            margin: 16px 0;
        }

        .input-td span {
            width: 100%;
        }

        .input-td span label {
            padding: 10px 12px;
            font-size: 12px;
            letter-spacing: 0.8px;
        }

        .form-table tr:nth-of-type(5) .input-td,
        .form-table tr:nth-of-type(7) .input-td {
            gap: 8px;
        }

        .input-td label {
            white-space: nowrap;
        }

        .text-td {
            height: 140px;
        }

        input[type="text"],
        input[type="email"],
        textarea {
            padding: 8px 10px;
        }

        input[name="institution" maxlength="200" aria-label="所属教育機関"]::placeholder,
        textarea::placeholder {
