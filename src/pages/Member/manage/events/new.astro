---
import { isMemberAccount } from "../../../../lib/accountVisibility.ts";
import StaffLayout from "../../../../layouts/StaffLayout.astro";
import ActivityEventForm from "../../../../components/ActivityEventForm.astro";
import { readUsers, isStaff } from "../../../../lib/auth";
const accounts = readUsers().filter(isMemberAccount);
const users = accounts.map((u) => ({ id: u.id, name: u.name }));
const staffUsers = accounts
  .filter(isStaff)
  .map((u) => ({ id: u.id, name: u.name }));
---

<StaffLayout title="企画を作成"
  ><h2>企画を作成</h2><p>内容を下書き保存した後、確認して公開できます。</p>
  <ActivityEventForm users={users} staffUsers={staffUsers} />
  <a class="member-back" href="/Management">運営画面へ戻る</a>
</StaffLayout>
