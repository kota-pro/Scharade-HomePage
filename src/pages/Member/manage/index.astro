---
import ActivityShareButton from "../../../components/ActivityShareButton.astro";
import StaffLayout from "../../../layouts/StaffLayout.astro";
import { readActivities } from "../../../lib/activities";
import { activityDate } from "../../../lib/activityTypes";
const data = readActivities();
const events = [...data.events].sort((a, b) =>
  b.createdAt.localeCompare(a.createdAt),
);
---

<StaffLayout title="管理・運営">
  <h2>管理・運営</h2>
  {
    Astro.url.searchParams.has("deleted") && (
      <p role="status">企画と関連する通知を削除しました。</p>
    )
  }
  <div class="admin-intro"><p>企画やお知らせの作成、写真展の受付、班分けを管理できます。</p></div>
  <section class="admin-section">
    <h2>企画・通知</h2>
    <ul class="admin-link-list">
      <li><a href="/Member/manage/events/new" aria-label="企画を作成"><span class="admin-item-label">企画を作成</span><span class="admin-item-description">撮影会・定例会・その他イベントを準備 →</span></a></li>
      <li><a href="/Member/manage/notifications" aria-label="通常のお知らせを送信"><span class="admin-item-label">通常のお知らせを送信</span><span class="admin-item-description">宛先を選んでメンバーへ通知 →</span></a></li>
    </ul>
  </section>
  <section class="admin-section">
    <h2>写真展・班分け</h2>
    <ul class="admin-link-list">
      <li><a href="/Member/manage/exhibitions" aria-label="写真展管理"><span class="admin-item-label">写真展管理</span><span class="admin-item-description">参加投票・フォーム・展示レイアウトを管理 →</span></a></li>
      <li><a href="/Member/manage/grouping" aria-label="班分け自動生成ツール"><span class="admin-item-label">班分け自動生成ツール</span><span class="admin-item-description">参加者と条件を選び、班案を作成・保存 →</span></a></li>
    </ul>
  </section>
  <section class="admin-section">
    <h2>企画一覧</h2>
    {!events.length && <p>企画はまだありません。</p>}
    <ul class="activity-list">
      {
        events.map((e) => (
          <li>
            <>
              <div class="activity-title-row"><a href={`/Member/manage/events/${e.id}`}>{e.title}</a>{e.status !== "draft" && <ActivityShareButton kind="events" id={e.id} title={e.title} />}</div>
              <small>
                {
                  { draft: "下書き", published: "公開中", cancelled: "中止" }[
                    e.status
                  ]
                }{" "}
                · {activityDate(e.startsAt)} · 担当 {e.ownerName}
              </small>
            </>
          </li>
        ))
      }
    </ul>
  </section>
  <a class="member-back" href="/Member">メンバーページへ戻る</a>
</StaffLayout>
