---
import PageTopNav from "../components/PageTopNav.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/UA+reset.css";
import { publicPageSections } from "../data/publicPages.ts";
import { SITE_URL } from "../lib/config.ts";

const sections = [
  ...publicPageSections,
  {
    title: "Search Engine Sitemap",
    note: "検索エンジン向けの XML sitemap は別途自動生成しています。",
    items: [
      {
        label: "sitemap.xml",
        href: `${SITE_URL}/sitemap.xml`,
        description: "公開ページの一覧を機械可読で出力",
      },
      {
        label: "robots.txt",
        href: `${SITE_URL}/robots.txt`,
        description: "クローラ向けの案内",
      },
    ],
  },
];
---

<Layout title="Sitemap | Scharade">
  <Fragment slot="main-slot">
    <div class="section-title">
      <h1>Sitemap</h1>
      <div class="section-title-line"></div>
    </div>
  </Fragment>

  <Fragment slot="menu-slot">
    <div class="menu-contents-inner">
      <PageTopNav />
    </div>
  </Fragment>

  <Fragment slot="body-slot">
    <div class="intro-block">
      <p>
        このページは公開用のサイトマップです。検索エンジン向けの XML sitemap は別で自動生成しています。
      </p>
    </div>

    {sections.map((section) => (
      <div class="sitemap_container">
        <h1>{section.title}</h1>
        <p class="section-note">{section.note}</p>
        <ul class="sitemap-list">
          {section.items.map((item) => (
            <li>
              <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}>
                <span class="item-label">{item.label}</span>
                <span class="item-description">{item.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Fragment>
</Layout>

<style>
  .section-title {
    display: flex;
    flex-direction: row;
    align-items: space-between;
    justify-content: center;
    margin-bottom: 55px;
    margin-top: 25px;
  }

  .section-title h1 {
    color: #000;
    font-family: "linotype-didot", serif;
    font-size: 96px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 14.4px;
    padding-right: 78px;
  }

  .section-title-line {
    width: 100%;
    position: relative;
  }

  .section-title-line::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    background: #000;
    position: absolute;
    top: 50%;
    right: 0;
  }

  .menu-contents-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }

  .intro-block,
  .sitemap_container {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    position: relative;
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .intro-block {
    margin-bottom: 40px;
  }

  .sitemap_container {
    padding-left: 20px;
  }

  .sitemap_container:not(:last-child) {
    margin-bottom: 60px;
  }

  .sitemap_container::after {
    content: "";
    display: block;
    width: 1px;
    background: #000;
    position: absolute;
    top: -15px;
    left: 0;
  }

  .intro-block::after {
    height: calc(100% + 30px);
  }

  .sitemap_container::after {
    height: calc(100% + 30px);
  }

  .intro-block p {
    color: #000;
    font-family: "Zen Kurenaido", sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.8;
    letter-spacing: 2.4px;
    margin: 0;
  }

  .sitemap_container h1 {
    color: #000;
    font-family: "Zen Old Mincho", serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 4.8px;
    margin-bottom: 16px;
  }

  .section-note {
    color: #000;
    font-family: "Zen Kurenaido", sans-serif;
    font-size: 16px;
    line-height: 1.8;
    letter-spacing: 2px;
    margin-bottom: 18px;
  }

  .sitemap-list {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px 24px;
  }

  .sitemap-list li {
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .sitemap-list a {
    color: #000;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 2px 0;
  }

  .item-label {
    font-family: "Zen Old Mincho", serif;
    font-size: 18px;
    letter-spacing: 2px;
  }

  .item-description {
    font-family: "Zen Kurenaido", sans-serif;
    font-size: 14px;
    letter-spacing: 1.2px;
    line-height: 1.6;
  }

  .sitemap-list a::after {
    content: "";
    height: 1px;
    width: 100%;
    background: #000;
    transform: scale(0, 1);
    transform-origin: center top;
    transition: transform 0.3s;
  }

  .sitemap-list a:hover::after {
    transform: scale(1, 1);
  }

  @media (max-width: 768px) {
    .section-title {
      margin-bottom: 35px;
    }

    .section-title h1 {
      font-size: 48px;
      letter-spacing: 7.2px;
      padding-right: 16px;
    }

    .intro-block,
    .sitemap_container {
      padding-left: 15px;
      margin-top: 12px;
      margin-bottom: 12px;
    }

    .intro-block {
      margin-bottom: 30px;
    }

    .intro-block::after,
    .sitemap_container::after {
      height: calc(100% + 24px);
      top: -12px;
    }

    .sitemap_container h1 {
      font-size: 25px;
      letter-spacing: 3px;
      margin-bottom: 12px;
    }

    .intro-block p,
    .section-note {
      font-size: 14px;
      letter-spacing: 1.6px;
      line-height: 1.7;
    }

    .sitemap-list {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .item-label {
      font-size: 16px;
      letter-spacing: 1px;
    }

    .item-description {
      font-size: 13px;
      letter-spacing: 1px;
    }
  }
</style>
