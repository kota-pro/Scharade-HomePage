---
import Layout from "../layouts/Layout.astro";
import "../styles/UA+reset.css";
import SiteImage from "../components/SiteImage.astro";
import {getContent, contentText} from "../lib/siteContent";
import {siteImage} from "../utils/siteImage";
import crypto from "node:crypto";
const content=getContent("about",Astro.locals.preview);
const common=getContent("common",Astro.locals.preview);
const scheduleGroups=[content.annual.slice(0,2),content.annual.slice(2,5),content.annual.slice(5,8),content.annual.slice(8,11),content.annual.slice(11)];
const cardIds=["apr-may","jun","jul","aug","sep","oct","nov","dec","jan","feb","mar"];
const groupOffsets=[0,2,5,8,11];
const equipmentAnimations=content.equipment.map((equipment,i) => {
 const count=equipment.photos.length;
 if(count === 0 || count === 5) return "";
 return `@keyframes equipmentSlide${i} {from,to,${400/count}% {transform:none} ${500/count}% {transform:translateX(-100%)} ${500/count+0.001}%,${100-100/count}% {transform:translateX(100%)}}`;
}).join("\n");
Astro.csp?.insertStyleHash(`sha256-${crypto.createHash("sha256").update(equipmentAnimations).digest("base64")}`);
const labels=["Apr. - Jun.","Jul. - Sep.","Oct. - Dec.","Jan. - Mar.","Others"];
---
<Layout>
<Fragment slot="main-slot">
    <div class = "section-title a-anchor" id="about-us-title"> 
        <h1>About&nbsp;us</h1>
        <div class = "section-title-line"></div>
    </div>
</Fragment>
<Fragment slot="menu-slot">
    <div class="menu">
        <a href="#about-us-title" class="menu-item">Top</a>
        <span>/</span>
        <a href="#information-title" class="menu-item">Information</a>
        <span>/</span>
        <a href="#annual-schedule-title" class="menu-item">Annual&nbsp;Schedule</a>
        <span>/</span>
        <a href="#equipments-title" class="menu-item">Equipments</a>
        <span>/</span>
        <a href="#faqs-title" class="menu-item">FAQs</a>
    </div>
</Fragment>
<Fragment slot="body-slot">
<style is:inline set:html={equipmentAnimations}/>
    <div class="explanation-about-us"><p>{content.introduction.split("\n").map((line,i) => <>{i > 0 && <br/>}{line}</>)}<br/><br/><br/><a class="href-anchor" href="/Contact">{content.contactText}</a></p>
    </div>
    <div class="information">
        <div class="contents-title a-anchor" id="information-title"><h1>Information</h1></div>
        <table>
            <caption>
                ※ {common.updated}現在
            </caption>
            <tbody>
                <tr>
                    <th scope="row">名前</th>
                    <td>{common.affiliation}&nbsp;&nbsp;&nbsp;&nbsp;{common.name}</td>
                    <td rowspan="6" id="map-td">
                        <span>
                            <div class="map" id="map">
                                <gmp-map
                                    center="35.70598589668286, 139.71658843895162"
                                    zoom="15"
                                    map-id="DEMO_MAP_ID"
                                    decoding="async"
                                >
                                    <gmp-advanced-marker
                                        position="35.70598589668286, 139.71658843895162"
                                        title="早稲田大学 戸山キャンパス 学生会館E224"
                                    ></gmp-advanced-marker>
                                </gmp-map>
                            </div>
                        </span>
                    </td>
                </tr>
                <tr>
                    <th scope="row">設立</th>
                    <td>{common.founded}</td>
                </tr>
                <tr>
                    <th scope="row">構成</th>
                    <td>{common.composition.split("\n").map((line,i) => <>{i > 0 && <br/>}{line}</>)}<br/>{common.members}&nbsp;<span style="display: inline-block">({common.memberRatio})</span></td>
                </tr>
                <tr>
                    <th scope="row">部費</th>
                    <td>入会費{common.entranceFee}円&nbsp;&nbsp;/&nbsp;&nbsp;半期{common.feeHalfYear}円</td>
                </tr>
                <tr>
                    <th scope="row">所在地</th>
                    <td>
                        <span class="address-span">
                            <div class="address-text">
                                <p>{common.address.split("\n").map((line,i) => <>{i === 1 && <br/>}{i > 1 && <>　</>}<span>{line}</span></>)}</p>
                            </div>
                            <a href={common.mapUrl} class="link-button" target="_blank">
                                <img src="/icons/link.svg" alt="Link Icon" />
                            </a>
                        </span>
                    </td>
                </tr>
                <tr>
                    <th scope="row"></th>
                    <td id="map-td-2">
                        <span>
                            <div class="map" id="map">
                                <gmp-map
                                    center="35.70598589668286, 139.71658843895162"
                                    zoom="15"
                                    map-id="DEMO_MAP_ID"
                                    decoding="async"
                                >
                                    <gmp-advanced-marker
                                        position="35.70598589668286, 139.71658843895162"
                                        title="早稲田大学 戸山キャンパス 学生会館E224"
                                    ></gmp-advanced-marker>
                                </gmp-map>
                            </div>
                        </span>
                    </td>
                </tr>
                <tr>
                    <th scope="row">連絡先</th>
                    <td><a class="href-anchor" href="Contact">{common.email}</a></td>
                </tr>
                <tr>
                    <th scope="row">SNS</th>
                    <td colspan="2"><span>Instagram ： <a class="href-anchor" href={common.instagram} target="_blank">{"@" + common.instagram.split("/").filter(Boolean).at(-1)}</a></span><span><span class="separator">/</span>X（旧twitter）： <a class="href-anchor" href={common.x} target="_blank">{"@" + common.x.split("/").filter(Boolean).at(-1)}</a></span></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="annual-schedule">
        <div class="contents-title a-anchor" id="annual-schedule-title"><h1>Annual Schedule</h1></div>
        <div class="tab">
          {scheduleGroups.map((group, i) => <>
           <input type="radio" id={`tab${i+1}`} name="tab" checked={i === 0}/>
           <label for={`tab${i+1}`}>{labels[i]}</label>
           <div class="tab-content">
            {group.map((entry,j) => <div class="card-cover" id={`card-${cardIds[groupOffsets[i]+j] ?? "extra-"+j}`} tabindex="0" style={`background-image:url(${siteImage(entry.image,960)});`}>
             <div class="card-contents" id={i === 0 && j === 0 ? "card-apr-may-contents" : undefined}>
              <h2>{entry.month}</h2><h1>{entry.title.split("\n").map((line,k) => <>{k > 0 && <br/>}{line}</>)}</h1>
              <div class="card-textbox"><p>{entry.text.split("\n").map((line,k) => <>{k > 0 && <br/>}{line}</>)}</p></div>
             </div>
            </div>)}
            {i === 4 && !group.length && <div class="card-cover" id="card-others" tabindex="0" style="background-image:url(/media/site/annual_schedule/others.webp)"><div class="card-contents" id="card-others-contents"><p>Now in production...</p><div class="card-textbox"><p>Now in production...</p></div></div></div>}
           </div>
          </>)}
        </div>
        <div class="swipe">
            <p>Swipe!!</p>
            <img src="/icons/swipearrow.svg" alt="Swipe Icon">
        </div>
    </div>
    <div class="Equipments">
        <div class="contents-title a-anchor" id="equipments-title"><h1>Equipments</h1></div>
        <div class="equipments-list">
         {content.equipment.map((equipment,i) => <div class="equipment-item">
          <div class="equipment-image"><div class="image-container">
           {equipment.photos.map((photo,j) => <section id={`image${i+1}${String.fromCharCode(97+j)}`} style={`position:${j === 0 ? "relative" : "absolute"};${equipment.photos.length === 5 ? "" : "animation-name:equipmentSlide"+i+";"}animation-duration:${equipment.photos.length*5}s;animation-delay:${j === 0 ? 0 : -equipment.photos.length*5+j*5}s;${equipment.photos.length === 1 ? "animation:none" : ""}`}><SiteImage src={photo.image} alt={photo.alt || equipment.title} sizes="(max-width:768px) 65vw, 400px"/></section>)}
          </div></div>
          <div class="equipment-description"><h1>No.{i+1}</h1><h2>{equipment.title.split("\n").map((line,j) => <>{j > 0 && <br/>}{line}</>)}</h2><p>{equipment.text.split("\n").map((line,j) => <>{j > 0 && <br/>}{line}</>)}</p></div>
         </div>)}
        </div>
    </div>
    <div class="FAQs">
        <div class="contents-title a-anchor" id="faqs-title"><h1>FAQs</h1></div>
        <div class="faqs-container">
         {content.faqs.map((faq,i) => <section class="faq"><h1>Q{i+1}</h1><h2>{faq.question}</h2><p>{contentText(faq.answer,common).split("\n").map((line,j) => <>{j > 0 && <br/>}{line}</>)}</p></section>)}
        </div>
    </div>
</Fragment>
</Layout>

<style>
    .a-anchor {
        padding-top: 130px;
        margin-top: -130px;
    }

    .href-anchor{
        text-decoration: none;
        position: relative;
        cursor: pointer;
    }

    .href-anchor::after {
        position: absolute;
        left: 0;
        right: 0;
        content: '';
        width: 100%;
        height: 1px;
        background: #000000;
        bottom: 0;
        transform: scale(0, 1);
        transform-origin: center top;
        transition: transform 0.3s;
    }

    .href-anchor:active {
        color: #0db49b;
    }
    
    .href-anchor:hover::after {
        transform: scale(1, 1);
    }

    .href-anchor:active::after {
        background: #0db49b;
    }

    .menu {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        writing-mode: vertical-rl;
        gap: 20px;
        position: sticky;
        top: 150px;
        z-index: 5;
    }

    .menu span {
        color: #000;
        font-size: 16px;
        user-select: none;
    }

    .menu-item {
        color: #000;
        font-family: "Zen Old Mincho";
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2px;
    }

    .menu-item:hover {
        color: #0db49b;
    }

    .section-title {
        display: flex;
        flex-direction: row;
        align-items: space-between;
        justify-content: center;
        margin-bottom: 55px;
    }

    .section-title  h1{
        color: #000;
        font-family: "linotype-didot", serif;
        font-size: 96px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 14.4px;
        padding-right: 78px;
    }

    .section-title-line {
        width: 100%;
        position: relative;
    }

    .section-title-line::after {
        content: '';
        display: block;
        width: 100%;
        height: 1px;
        background: #000;
        position: absolute;
        top: 50%;
        right: 0;
    }

    .explanation-about-us {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-bottom: 148px;
    }

    .explanation-about-us p{
        color: #000;
        font-family: "Zen Kurenaido";
        font-size: 24px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 3.6px;
    }

    .information {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        justify-content: center;
    }

    .contents-title {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: right;
        margin-bottom: 15px;
    }

    .contents-title h1{
        color: #000;
        font-family: "linotype-didot", serif;
        font-size: 48px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 7.2px;
        text-align: right;
    }

    .information table{
        display: table;
        width: 100%;
        table-layout: auto;
        color: #000;
        font-family: "Zen Kurenaido";
        font-size: 20px;
    }

    .information caption{
        caption-side: bottom;
        text-align: right;
    }

    .information th,
    .information td {
        word-wrap: break-word;
        border-top: 1px solid #000;
        padding: 20px;
        color: #000;
        font-family: "Zen Kurenaido";
        font-weight: 400;
    }

    .information tr:nth-child(6) {
        display: none;
    }

    .information tr:nth-child(8)  span {
        display: inline-block;
    }

    .information tr:last-child {
        border-bottom: 1px solid #000;
    }

    .information th {
        font-size: 24px;
        padding: 20px 30px;
    }

    .separator{
        margin: 0 30px;
    }

    #map-td {
        padding: 0;
    }

    #map-td-2 {
        display: none;
    }

    #map-td span{
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #map {
        width: 450px;
        height: 450px;
        margin: 35px;
        flex-shrink: 0;
        flex-basis: auto;
    }

    .address-span{
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .address-text > p > span {
        white-space: nowrap;
    }

    .link-button{
        padding: 15px;
        width: 50px;
        height: 50px;
        margin-left: 20px;
    }

    .link-button:hover {
        background-color: #f0f0f0;
    }

    .link-button img {
        width: 20px;
        height: 20px;
        vertical-align: top;
    }

    .annual-schedule {
        margin-top: 148px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .tab {
        display: flex;
        flex-wrap: wrap;
        width: 100%;
        position: relative;
    }

    .tab > label {
        flex: 1 1;
        order: -1;
        min-width: 70px;
        padding: .7em 1em .5em;
        border-bottom: 1px solid #000000;
        border-radius: 0;
        background-color: #fdfdfd;
        color: #000000;
        font-family: "Zen Old Mincho";
        font-size: 15px;
        letter-spacing: 2.25px;
        font-weight: 400;
        font-style: normal;
        text-align: center;
        cursor: pointer;
    }

    .tab > label:hover {
        color: #0db49b;
    }

    .tab input {
        display: none;
    }

    .tab-content {
        display: none;
        width: 100%;
        background-color: #fff;
        position: relative;
        align-items: center;
        justify-content: space-around;
        padding: 50px 0px;
    }

    #tab1:checked ~ label[for="tab1"],
    #tab2:checked ~ label[for="tab2"],
    #tab3:checked ~ label[for="tab3"],
    #tab4:checked ~ label[for="tab4"],
    #tab5:checked ~ label[for="tab5"] {
        background-color: #fff;
        border-color: #000000;
        border-style: solid;
        border-width: 1px 1px 0px 1px;
        border-radius: 2px 2px 0px 0px;
        color: #0db49b;
    }

    #tab1:checked ~ label[for="tab1"] + div,
    #tab2:checked ~ label[for="tab2"] + div,
    #tab3:checked ~ label[for="tab3"] + div,
    #tab4:checked ~ label[for="tab4"] + div,
    #tab5:checked ~ label[for="tab5"] + div {
        display: flex;
        background-color: #fff;
    }

    #tab1:checked ~ label[for="tab1"] + div::after,
    #tab2:checked ~ label[for="tab2"] + div::after,
    #tab3:checked ~ label[for="tab3"] + div::after,
    #tab4:checked ~ label[for="tab4"] + div::after,
    #tab5:checked ~ label[for="tab5"] + div::after {
        content: '';
        display: block;
        width: 100%;
        height: 1px;
        background: #000;
        position: absolute;
        top: 100%;
        left: 0;
    }

    .tab > label[for="tab5"],
    .tab > input#tab5 + label,
    .tab > input#tab5 + label + div {
        display: none;
    }

    .card-cover {
        padding: 16px 25px;
        box-shadow: 4px 4px 8px rgba(0, 0, 0, 0.2);
        flex-shrink: 0;
        border-radius: 10px;
        position: relative;
    }

    .card-cover::before {
        content: '';
        border-radius: 10px;
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        transition: background-color 0.3s ease;
    }

    .card-cover::after {
        content: '';
        border-radius: 10px;
        position: absolute;
        top: 7px;
        right: 7px;
        bottom: 7px;
        left: 7px;
        border:#000000 0.5px solid;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .card-contents {
        height: 100%;
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: space-between;
    }

    .card-cover h1 {
        font-family: "Zen Old Mincho";
        font-size: calc(40/1440 * 100vw);
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        transition: opacity 0.3s ease 0.1s;
    }
    .card-cover h2 {
        font-family: "Zen Old Mincho";
        font-size: calc(50/1440 * 100vw);
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        transition: opacity 0.3s ease 0.1s;
    }

    .card-contents h1{
        text-align: center;
        opacity: 0;
        color: #000000;
        transition: opacity 0.3s ease 0.1s;
    }

    .card-contents h2 {
        color: #ffffff;
        text-shadow: #5c5c5c 2px 2px 4px;
        width: 100%;
    }

    .card-textbox {
        opacity: 0;
        height: 170px;
        margin-top: 10px;
        overflow-y: scroll;
        text-overflow: ellipsis;
        transition: opacity 0.3s ease 0.1s;
    }

    .card-cover:hover::before {
        background-color: rgba(255, 255, 255, 1);
    }

    .card-cover:hover::after {
        opacity: 1;
    }

    .card-cover:hover h1 {
        opacity: 1;
        z-index: 1;
    }
    .card-cover:hover h2 {
        color: #000000;
        z-index: 1;
        text-shadow: none;
    }
    .card-cover:hover .card-textbox {
        opacity: 1;
        z-index: 1;
    }

    .card-textbox p {
        color: #000;
        font-family: "Zen Kurenaido";
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2.4px;
    }

    #card-apr-may{
        width: calc(655/1440*100vw);
        aspect-ratio: 655/414;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    #card-apr-may-contents {
        align-items: flex-start;
    }

    #card-jun,
    #card-jul,
    #card-aug,
    #card-sep,
    #card-oct,
    #card-nov,
    #card-dec,
    #card-jan,
    #card-feb,
    #card-mar {
        width: calc(290/1440*100vw);
        aspect-ratio: 138/197;
        background-size: cover;
        background-repeat: no-repeat;
    }

    #card-jun {
        background-position: 46%;
    }

    #card-jul {
        background-position: 70%;
    }

    #card-aug {
        background-position: center;
    }

    #card-sep {
        background-position: center;
    }

    #card-oct {
        background-position: center;
    }

    #card-nov {
        background-size: cover;
        background-position: 42%;
    }

    #card-dec {
        background-position: center;
    }

    #card-jan {
        background-position: center;
    }

    #card-feb {
        background-size: cover;
        background-position: center;
    }

    #card-mar {
        background-position: center;
    }

    #card-others {
        width: 100%;
        height: 414px;
        background-size: cover;
        background-position: center;
    }

    #card-others-contents {
        justify-content: right;
        align-items: flex-end;
    }

    #card-others-contents p {
        color: #000000;
        font-family: "Zen Kurenaido";
        font-size: 30px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 3.6px;
    }

    .swipe {
        width: 100%;
        display: none;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        margin-top: 20px;
    }

    .Equipments {
        margin-top: 148px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .equipments-list {
        width: 100%;
        height: 525px;
        overflow-y: scroll;
        padding: 0 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        row-gap: 50px;
        scroll-snap-type: y mandatory;
    }

    .equipments-list::-webkit-scrollbar {
        width: 7px;
        top: 50%;
        background-image: url('../assets/equipments/scrollbar-bg.svg');
        background-size: auto 100%;
        background-repeat: no-repeat;
    }

    .equipments-list::-webkit-scrollbar-thumb {
        background-image: url('../assets/equipments/scrollbar-thumb.svg');
        background-size: auto 100%;
        background-repeat: no-repeat;
    }

    .equipments-list::-webkit-scrollbar-thumb:hover {
        background-color: #696969;
    }

    .equipment-item {
        width: 100%;
        height: 500px;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        position: relative;
        scroll-snap-align: start;
    }

    .equipment-item::after {
        content: '';
        display: block;
        width: 70%;
        height: 1px;
        background: #000;
        position: absolute;
        bottom: -25px;
        left: 15%;
    }

    .equipment-image {
        width: 400px;
        height: 500px;
        position: relative;
    }

    .equipment-image::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('../assets/equipments/equipments-cover.svg');
        background-size: cover;
        background-position: center;
        user-select: none;
    }

    .image-container {
        width: 400px;
        height: 100%;
        position: relative;
        text-align: center;
        -webkit-user-select: none;
        user-select: none;
        overflow: hidden;
        border-radius: 10px;
    }

    .image-container section {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .image-container section :global(img) {
        width: 100%;
        height: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        box-sizing: border-box;
        vertical-align: middle;
    }

    .equipment-description {
        width: 100%;
        height: 100%;
