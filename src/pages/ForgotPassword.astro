---
import "../styles/Auth.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="main-slot">
    <div class="section-title">
      <h1>Portfolio</h1><div class="section-title-line"></div>
    </div>
  </Fragment>
  <Fragment slot="menu-slot">
    <div class="menu-contents-inner">
      <a href="/Login" class="page-top-nav" aria-label="ログイン画面へ戻る"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M16 21.308L6.692 12L16 2.692l1.064 1.064L8.819 12l8.244 8.244z"
          ></path></svg
        ></a>
    </div>
  </Fragment>
  <Fragment slot="body-slot">
    <section class="auth-section">
      <div class="auth-heading">
        <p class="auth-pill">Member Only</p>
        <h1>Reset password</h1>
        <p>
          登録したメールアドレスへ、パスワード再設定用のリンクをお送りします。
        </p>
      </div>
      <div class="auth-grid auth-grid-single">
        <div class="auth-card">
          <h2>Send link</h2>
          <small>再設定用リンクの有効期限は1時間です</small>
          <form class="auth-form" id="forgot-password-form">
            <div class="form-field">
              <label for="reset-email">Email</label>
              <input
                id="reset-email"
                type="email"
                name="email"
                autocomplete="email"
                required
              />
            </div>
            <div class="auth-actions">
              <button type="submit" class="primary-button"
                >再設定メールを送信</button
              >
              <p
                class="auth-message"
                id="reset-request-message"
                aria-live="polite"
              >
              </p>
            </div>
          </form>
          <a class="auth-link" href="/Login">ログイン画面へ戻る</a>
        </div>
      </div>
      <script>
        const form = document.getElementById(
          "forgot-password-form",
        ) as HTMLFormElement;
        const messageEl = document.getElementById("reset-request-message");
        const button = form?.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement | null;

        function setMessage(text: string, kind: string = "") {
          if (!messageEl) return;
          messageEl.textContent = text;
          if (kind) messageEl.dataset.kind = kind;
          else messageEl.removeAttribute("data-kind");
        }

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          setMessage("");
          if (button) button.disabled = true;
          try {
            const data = new FormData(form);
            const response = await fetch("/api/auth/password-reset/request", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email: String(data.get("email") ?? "") }),
            });
            const result = await response.json().catch(() => null);
            setMessage(
              result?.message ||
                "処理に失敗しました。時間をおいて再度お試しください。",
              response.ok ? "success" : "error",
            );
            if (response.ok) form.reset();
          } catch {
            setMessage(
              "通信エラーが発生しました。時間をおいて再度お試しください。",
              "error",
            );
          } finally {
            if (button) button.disabled = false;
          }
        });
      </script>
    </section>
  </Fragment>
</Layout>
