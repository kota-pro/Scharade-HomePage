---
import BlogPostPage from "../../components/BlogPostPage.astro";
import { getBlogBySlug } from "../../lib/blog";
import type { Blog } from "../../types/microcms";
// Decode the original request path once. Astro.url/params already decode some
// characters, so decoding those again would change literal percent sequences.
let slug: string;
try {
  slug = decodeURIComponent(new URL(Astro.request.url).pathname.slice("/posts/".length).replace(/\/$/, ""));
} catch {
  return Astro.rewrite("/404");
}
if (!slug) return Astro.rewrite("/404");

let post: Blog | undefined;
try {
  post = await getBlogBySlug(slug);
} catch {
  return Astro.rewrite("/503");
}

if (!post) {
  return Astro.rewrite("/404");
}

---

<BlogPostPage post={post} fromParam={Astro.url.searchParams.get("from")} />

<script>import "../../scripts/postBody.js";</script>
