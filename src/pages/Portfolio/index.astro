---
import PageTopNav from "../../components/PageTopNav.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/UA+reset.css";
import "../../styles/Portfolio.css";

import { getAllPortfolios, normalizePortfolioGrade } from "../../lib/microcms";
import { getContent } from "../../lib/siteContent";
import { optimizeMicrocmsImage } from "../../utils/microcmsImage";
import { isListedPortfolio, isArchivedPortfolio } from "../../data/portfolioVisibility";
import { portfolioOffice, portfolioOfficeOrder } from "../../data/portfolioOffices";

const isLoggedIn = Boolean(Astro.locals.user);
const allMembers = await getAllPortfolios().catch(() => null);

const GRADE_TABS = [
  "All",
  "1st Grade",
  "2nd Grade",
  "3rd Grade",
  "4th Grade",
  "Master's Program",
  "Doctor's Program",
  "International",
  "OB/OG",
] as const;

const allPortfolios = (allMembers ?? [])
  .filter(
    (portfolio) =>
      isListedPortfolio(portfolio) &&
      (isLoggedIn ||
        Boolean(portfolio.icon?.url?.trim()) ||
        (portfolio.pictures ?? []).some((picture) => Boolean(picture?.url?.trim()))),
  )
  .map((portfolio) => {
    const gradeText = isArchivedPortfolio(portfolio) ? "OB/OG" : normalizePortfolioGrade(portfolio.grade);
    const office = gradeText === "OB/OG" ? "" : portfolioOffice(portfolio.role);
    const iconSrc = optimizeMicrocmsImage(portfolio.icon?.url ?? "", { width: 480, quality: 78 }) ||
      "/images/placeholder_icon.jpeg";
    return { ...portfolio, gradeText, office, iconSrc };
  })
  .sort(
    (a, b) =>
      portfolioOfficeOrder(a.office) - portfolioOfficeOrder(b.office) ||
      a.name.localeCompare(b.name, "ja"),
  );

const executives = allPortfolios.filter((portfolio) => portfolio.office);
---

<Layout title="Portfolio">
  <Fragment slot="main-slot">
    <div class="section-title">
      <h1>Portfolio</h1>
      <div class="section-title-line"></div>
    </div>
  </Fragment>

  <Fragment slot="menu-slot">
    <div class="menu-contents-inner">
      <PageTopNav />
    </div>
  </Fragment>

  <Fragment slot="body-slot">
    <div class="explanation-area">
      <p>{getContent("portfolio", Astro.locals.preview).introduction}</p>
    </div>

    {
      !allMembers && (
        <p class="service-notice" role="alert">
          Portfolioを読み込めませんでした。時間をおいて再読み込みしてください。
        </p>
      )
    }
    {
      executives.length > 0 && (
        <details class="member-section-details executive-section" open>
          <summary class="section-heading">
            <img class="arrow-icon" src="/icons/rightarrow.svg" alt="" />
            Executives / 幹部
          </summary>
          <div class="member-grid">
            {executives.map((portfolio) => (
              <a href={`/Portfolio/${portfolio.id}`} class="member-card">
                <div class="member-image-placeholder">
                  <img
                    src={portfolio.iconSrc}
                    alt={portfolio.name}
                    loading="lazy"
                  />
                </div>
                <div class="member-info">
                  <p class="member-grade">{portfolio.office}</p>
                  <p class="member-name">{portfolio.name}</p>
                </div>
              </a>
            ))}
          </div>
        </details>
      )
    }
    {
      GRADE_TABS.map((tab) => (
        <details
          class="member-section-details"
          name="member-section"
          data-portfolio-grade={tab}
          open={tab === "All"}
        >
          <summary class="section-heading">
            <img
              class="arrow-icon"
              src="/icons/rightarrow.svg"
              alt="arrow icon"
            />
            {tab === "All" ? "All Members" : `${tab}`}
          </summary>
          <div class="member-grid">
            {allPortfolios
              .filter((p) => {
                if (tab === "All") return p.gradeText !== "OB/OG";
                return p.gradeText === tab;
              })
              .map((portfolio) => (
                <a href={`/Portfolio/${portfolio.id}`} class="member-card">
                  <div class="member-image-placeholder">
                    <img
                      src={portfolio.iconSrc}
                      alt={portfolio.name}
                      loading="lazy"
                    />
                  </div>
                  <div class="member-info">
                    <p class="member-grade">{portfolio.gradeText}</p>
                    <p class="member-name">{portfolio.name}</p>
                  </div>
                </a>
              ))}
          </div>
        </details>
      ))
    }
  </Fragment>
</Layout>

<script>
  const details = document.querySelectorAll("details");
  details.forEach((detail) => {
    detail.addEventListener("toggle", () => {
      const arrow = detail.querySelector(".arrow-icon") as HTMLElement;
      if (arrow) {
        arrow.style.transform = detail.open ? "rotate(90deg)" : "rotate(0deg)";
      }
    });
  });
</script>
