---
import { cmsPhotoId } from "../../lib/photoIdentity";
import { photoMetadata } from "../../lib/photoState";
import PageTopNav from "../../components/PageTopNav.astro";
import PortfolioIntroductionEditor from "../../components/PortfolioIntroductionEditor.astro";
import PortfolioPhotoEditor from "../../components/PortfolioPhotoEditor.astro";
import PortfolioSeriesEditor from "../../components/PortfolioSeriesEditor.astro";
import PortfolioBookEditor from "../../components/PortfolioBookEditor.astro";
import { listPortfolioBooks, readPortfolioBooks } from "../../lib/portfolioBooks";
import { portfolioSeriesForPictures } from "../../lib/portfolioSeries";
import "../../styles/Auth.css";
import "../../styles/PortfolioEdit.css";
import Layout from "../../layouts/Layout.astro";
import type { Portfolio } from "../../lib/microcms";
import {
  getPortfolioDetail,
  normalizePortfolioGrade,
} from "../../lib/microcms";
import { getUserFromRequest, isAdmin, canEditPortfolio } from "../../lib/auth";

const { user } = getUserFromRequest(Astro.request);
const admin = isAdmin(user);
const targetId = Astro.url.searchParams.get("id") || user?.portfolioId || "";
const canEdit = canEditPortfolio(user, targetId);
if (targetId && user && !canEdit)
  return new Response("このPortfolioを編集する権限がありません。", {
    status: 403,
  });

let statusInfo = !user
  ? {
      title: "ログインが必要です",
      detail:
        "ご自身のメールアドレスとパスワードでログインした後にこのページへ戻ってください。",
    }
  : !user.approved
    ? {
        title: "アカウントが承認待ちです",
        detail:
          "承認されるまではプロフィールを更新できません。管理者へご連絡ください。",
      }
    : !user.portfolioId
      ? {
          title: "プロフィールが準備されていません",
          detail: "運営へプロフィールの準備を依頼してください。",
        }
      : null;

let portfolio: Portfolio | null = null;
if (canEdit && targetId) {
  try {
    portfolio = await getPortfolioDetail<Portfolio>(targetId);
  } catch (error) {
    const missing = String(error).includes("response status: 404");
    Astro.response.status = missing ? 404 : 503;
    statusInfo = missing
      ? {
          title: "Portfolioが見つかりません",
          detail:
            "プロフィールが削除されたか、非公開になっている可能性があります。運営へプロフィールの表示状態の確認を依頼してください。",
        }
      : {
          title: "Portfolioを取得できません",
          detail:
            "時間をおいて再読み込みしてください。変更は保存されていません。",
        };
  }
}

const pictureUrls = new Map((portfolio?.pictures ?? []).map(pic => [cmsPhotoId(pic.url), pic.url]));
const bookState = portfolio ? readPortfolioBooks(targetId) : { revision: "", books: [] };
const initialFormData = {
  name: portfolio?.name ?? "",
  iconUrl: portfolio?.icon?.url ?? "",
  hashtags: Array.isArray(portfolio?.hashtags)
    ? (portfolio?.hashtags as string[])
    : [],
  x_url: portfolio?.x_url ?? "",
  instagram: portfolio?.instagram ?? "",
  camera: portfolio?.camera ?? "",
  self_introduction: portfolio?.self_introduction ?? "",
  pictures: (portfolio?.pictures ?? []).map((pic) => pic.url).filter(Boolean),
  grade: normalizePortfolioGrade(portfolio?.grade),
  photoIds: Object.fromEntries((portfolio?.pictures ?? []).map(pic => [pic.url, cmsPhotoId(pic.url)])),
  photoSizes: Object.fromEntries((portfolio?.pictures ?? []).map(pic => [pic.url, { width: pic.width, height: pic.height }])),
  photoSeries: portfolio ? portfolioSeriesForPictures(targetId, portfolio.pictures).map(work => ({
    ...work, photos: work.photos.map(photo => ({ ...photo, assetId: pictureUrls.get(photo.assetId)! })),
  })) : [],
  photoMetadata: Object.fromEntries((portfolio?.pictures ?? []).map(pic => [pic.url, photoMetadata({ source: "portfolio", containerId: targetId, imageId: cmsPhotoId(pic.url) })])),
  portfolioBookRevision: bookState.revision,
  portfolioBooks: portfolio ? listPortfolioBooks(targetId, bookState) : [],
};

const HASHTAG_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "夜景", label: "夜景" },
  { value: "夕焼け", label: "夕焼け" },
  { value: "朝焼け", label: "朝焼け" },
  { value: "cityscape", label: "cityscape" },
  { value: "landscape", label: "landscape" },
  { value: "seascape", label: "seascape" },
  { value: "snapshot", label: "snapshot" },
  { value: "film", label: "film" },
  { value: "モノクロ", label: "モノクロ" },
  { value: "ストリート", label: "ストリート" },
  { value: "ポートレート", label: "ポートレート" },
  { value: "architecture", label: "architecture" },
  { value: "nature", label: "nature" },
  { value: "travel", label: "travel" },
  { value: "macro", label: "macro" },
  { value: "event", label: "event" },
];

const portfolioViewUrl = canEdit ? `/Portfolio/${targetId}` : null;
const hasPortfolio = canEdit && Boolean(portfolio);

const GRADE_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "1st Grade", label: "1st Grade（1年）" },
  { value: "2nd Grade", label: "2nd Grade（2年）" },
  { value: "3rd Grade", label: "3rd Grade（3年）" },
  { value: "4th Grade", label: "4th Grade（4年）" },
  { value: "International", label: "International（留学生）" },
  { value: "Master's Program", label: "Master's Program（修士）" },
  { value: "Doctor's Program", label: "Doctor's Program（博士）" },
  { value: "OB/OG", label: "OB/OG（卒業生）" },
];

const inlineSerialize = (value: unknown) =>
  JSON.stringify(value)
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");

const initialFormDataSerialized = inlineSerialize(initialFormData);
const portfolioViewUrlSerialized = inlineSerialize(portfolioViewUrl ?? "");
---

<Layout
  title="Portfolioの編集"
  breadcrumbs={[
    { label: "Home", href: "/" },
    {
      label: admin ? "Portfolio管理" : "Portfolio",
      href: admin ? "/Admin/portfolios" : "/Portfolio",
    },
    ...(portfolio ? [{ label: portfolio.name, href: portfolioViewUrl! }] : []),
    { label: "編集" },
  ]}
>
  <Fragment slot="main-slot">
    <div class="section-title">
      <h1>Portfolio</h1>
      <div class="section-title-line"></div>
    </div>
  </Fragment>

  <Fragment slot="menu-slot">
    <div class="menu-contents-inner">
      <PageTopNav />
    </div>
  </Fragment>

  <Fragment slot="body-slot">
    <section class="portfolio-edit-page">
      <div class="auth-heading">
        <p class="auth-pill">Member</p>
        <h1>Edit Portfolio</h1>
        <p>
          登録済みのプロフィールを編集して、最新の活動内容や写真を届けましょう。
        </p>
      </div>

      <div class="portfolio-edit-grid">
        {
          hasPortfolio ? (
            <form
              id="portfolio-form"
              class="portfolio-form"
              method="post"
              action="#"
            >
              <input type="hidden" id="field-target-id" value={targetId} />
              <div class="form-field">
                <label for="field-name">Name</label>
                <input
                  id="field-name"
                  name="name"
                  type="text"
                  required
                  maxlength="80"
                  value={initialFormData.name}
                />
              </div>

              <div class="form-field">
                <label for="field-icon-file">Icon</label>
                <input id="field-icon-file" type="file" accept="image/*" />
                <small class="helper">
                  アイコン画像をアップロードして設定します。
                </small>
                <div class="portfolio-icon-preview" id="icon-preview" />
              </div>

              <div class="form-field">
                <label for="field-hashtags">Hashtags</label>
                <select id="field-hashtags" name="hashtags" multiple>
                  {HASHTAG_OPTIONS.map(({ value, label }) => (
                    <option
                      value={value}
                      selected={initialFormData.hashtags.includes(value)}
                    >
                      #{label}
                    </option>
                  ))}
                </select>
                <small class="helper">
                  複数選択できます（⌘/Ctrl
                  を押しながらクリック、またはドラッグ）。
                </small>
              </div>

              <div class="form-field">
                <label for="field-grade">Grade / 学年</label>
                <select id="field-grade" name="grade">
                  <option value="">選択なし</option>
                  {GRADE_OPTIONS.map(({ value, label }) => (
                    <option
                      value={value}
                      selected={initialFormData.grade === value}
                    >
                      {label}
                    </option>
                  ))}
                </select>
                <small class="helper">あなたの学年を選択してください。保存した学年は、管理者が名簿の参照先を変更し、確認画面で適用するまで保持されます。</small>
              </div>

              <div class="form-field">
                <label for="field-x-url">X (Twitter) URL</label>
                <input
                  id="field-x-url"
                  name="x_url"
                  type="url"
                  value={initialFormData.x_url}
                />
              </div>

              <div class="form-field">
                <label for="field-instagram">Instagram username</label>
                <input
                  id="field-instagram"
                  name="instagram"
                  type="text"
                  value={initialFormData.instagram}
                />
              </div>

              <div class="form-field">
                <label for="field-camera">Camera</label>
                <input
                  id="field-camera"
                  name="camera"
                  type="text"
                  value={initialFormData.camera}
                />
              </div>

              <PortfolioIntroductionEditor value={initialFormData.self_introduction} />

              <section class="upload-area" aria-labelledby="portfolio-pictures-heading">
                <div class="portfolio-pictures-heading">
                  <h2 id="portfolio-pictures-heading">Pictures</h2>
                  <span data-picture-count aria-live="polite" />
                </div>
                <p class="helper">作品ごとに写真情報を編集できます。前へ・後へで掲載順を変更します。写真は1枚5MB以内に自動で圧縮します。</p>
                <div class="portfolio-work-tools">
                  <div class="portfolio-upload-control">
                  <input
                    id="picture-files"
                    class="portfolio-file-input"
                    type="file"
                    accept="image/*"
                    multiple
                    aria-label="作品画像を追加"
                    aria-describedby="picture-upload-help"
                  />
                  <label class="portfolio-upload-target" for="picture-files">
                    <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
                    <span>単写真を追加</span>
                    <small id="picture-upload-help">複数選択すると別々の作品になります</small>
                  </label>
                  </div>
                  <div class="portfolio-upload-control">
                    <input id="series-files" class="portfolio-file-input" type="file" accept="image/*" multiple aria-label="組写真を追加" />
                    <label class="portfolio-upload-target" for="series-files">
                      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h10v8H3zM15 4h6v8h-6zM3 14h6v6H3zM11 14h10v6H11z" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
                      <span>組写真を追加</span><small>2枚以上を配置して1作品にします</small>
                    </label>
                  </div>
                  <button type="button" class="portfolio-upload-target" data-portfolio-book-create aria-haspopup="dialog" aria-controls="portfolio-book-editor">
                    <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6C8 3 5 3 2 4v14c4-1 7 0 10 2c3-2 6-3 10-2V4c-3-1-6-1-10 2v14" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
                    <span>ブックを追加</span><small>PDFと表紙を選んで投稿します</small>
                  </button>
                </div>
                <p class="portfolio-upload-status" data-picture-upload-status role="status" aria-live="polite" hidden />
                <div class="portfolio-series-tools">
                  <button type="button" data-portfolio-series-create>登録済みの写真から組写真を作る</button>
                  <div data-portfolio-series-list></div>
                  <div data-portfolio-book-list></div>
                </div>
                <div class="picture-list" id="picture-list" />
              </section>

              <div
                class="status-message"
                id="status-message"
                aria-live="polite"
              />

              <div class="form-actions">
                <button id="submit-button" type="submit" class="primary-button">
                  Save changes
                </button>
                <a class="auth-link" href={portfolioViewUrl}>
                  View portfolio
                </a>
              </div>
            </form>
          ) : (
            <div class="auth-card">
              <h2>{statusInfo?.title ?? "編集できません"}</h2>
              <small class="auth-note" role="alert">
                {statusInfo?.detail ?? "編集ステータスを確認してください。"}
              </small>
              {user?.email && (
                <p class="auth-note">
                  Email: {user.email}
                  <br />
                  User ID: {user.id}
                </p>
              )}
              <div class="form-actions">
                {!user && (
                  <a class="auth-link" href="/Login">
                    ログインページへ
                  </a>
                )}
                <a class="auth-link" href="/Contact">
                  お問い合わせ
                </a>
              </div>
            </div>
          )
        }
      </div>
      {
        hasPortfolio && (
          <div
            id="portfolio-edit-data"
            data-initial={initialFormDataSerialized}
            data-view-url={portfolioViewUrlSerialized}
            hidden
          />
        )
      }
    </section>
    {hasPortfolio && <PortfolioPhotoEditor />}
    {hasPortfolio && <PortfolioSeriesEditor />}
    {hasPortfolio && <PortfolioBookEditor />}
  </Fragment>
</Layout>

<script>
  import "../../scripts/portfolioEditor";
</script>
