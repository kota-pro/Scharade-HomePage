---
import PageTopNav from "../../components/PageTopNav.astro";
import "../../styles/PhotoGallery.css";
export const prerender = false;


import Layout from "../../layouts/Layout.astro";
import PortfolioShareButton from "../../components/PortfolioShareButton.astro";
import PortfolioShareDialog from "../../components/PortfolioShareDialog.astro";
import { getUserFromRequest, canEditPortfolio } from "../../lib/auth";
import {
  getPortfolioDetail,
  normalizePortfolioGrade,
  type Portfolio,
} from "../../lib/microcms";
import { optimizeMicrocmsImage } from "../../utils/microcmsImage";
import { safeExternalUrl } from "../../lib/contentSecurity.ts";
import "../../styles/UA+reset.css";

const { id } = Astro.params;
let portfolio: Portfolio;
try {
  portfolio = await getPortfolioDetail<Portfolio>(id as string);
} catch (error) {
  if (String(error).includes("404")) return Astro.rewrite("/404");
  return Astro.rewrite("/503");
}
const gradeText = normalizePortfolioGrade(portfolio.grade);
const generation = Number.isInteger(portfolio.generation) && Number(portfolio.generation) > 0 && Number(portfolio.generation) <= 100000 ? portfolio.generation : null;
const externalX = safeExternalUrl(portfolio.x_url);
const hasPictures = portfolio.pictures && portfolio.pictures.length > 0;
const pageTitle = `${portfolio.name} | Portfolio`;
const { user } = getUserFromRequest(Astro.request);
const canEditLink = canEditPortfolio(user, id ?? "");
const isOwnPortfolio = Boolean(user && user.portfolioId === id);

const backLinkMap = {
  portfolio: {
    href: "/Portfolio",
    label: "Portfolioへ戻る",
  },
};
type BackLinkMap = typeof backLinkMap;
type FromParam = keyof BackLinkMap;
const isFromParam = (value: string | null): value is FromParam => {
  return value !== null && value in backLinkMap;
};
const fromParam = Astro.url.searchParams.get("from");
const backLink = isFromParam(fromParam) ? backLinkMap[fromParam] : null;
const backLinkMapJSON = JSON.stringify(backLink);

const ITEMS_PER_PAGE = 100;
const totalPages = Math.max(1, Math.ceil((portfolio.pictures?.length ?? 0) / ITEMS_PER_PAGE));
---

<Layout title={pageTitle}>
  <Fragment slot="main-slot">
    <div class="section-title">
      <h1>Portfolio</h1>
      <div class="section-title-line"></div>
    </div>
  </Fragment>

  <Fragment slot="menu-slot">
    <div class="menu-contents-inner">
      <PageTopNav />
    </div>
  </Fragment>

  <Fragment slot="body-slot">
    <div class="portfolio-detail-wrapper">
      <section class="profile-header">
        <div class="profile-grid">
          <div class="profile-info">
            <div class="name-and-sns">
              <h2 class="user-name">{portfolio.name}</h2>
              <div class="sns">
                {
                  externalX && (
                    <a
                      href={externalX}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-link"
                    >
                      <img src="/icons/X.svg" alt="X" />
                    </a>
                  )
                }
                {
                  portfolio.instagram && (
                    <a
                      href={`https://instagram.com/${portfolio.instagram}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-link"
                    >
                      <img src="/icons/Instagram.svg" alt="Instagram" />
                    </a>
                  )
                }
                <PortfolioShareButton name={portfolio.name} />
              </div>
            </div>
            <div class="tags">
              {
                portfolio.hashtags?.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))
              }
            </div>
            <p class="camera-info">
              使用機材：{portfolio.camera || "なし"}
            </p>
            <p class="self-introduction">
              {portfolio.self_introduction}
            </p>
          </div>
          <div class="icon">
            <div class="circle">
              <img
                src={portfolio.icon
                  ? optimizeMicrocmsImage(portfolio.icon.url, {
                      width: 640,
                      quality: 80,
                    })
                  : "/images/placeholder_icon.jpeg"}
                alt={portfolio.name}
                class="profile-icon"
              />
              <span class="suffix">{generation && <>{generation}<br/>期生</>}</span>
            </div>
            {gradeText && <p class="profile-grade">{gradeText}</p>}
          </div>
        </div>
      </section>
    </div>
    <PortfolioShareDialog name={portfolio.name} id={id!} />

    <div
      class="back-link"
      id="post-back-link"
      data-map={backLinkMapJSON}
      hidden={!backLink && !canEditLink}
    >
      {
        canEditLink && (
          <div class="edit-link-wrapper profile-actions">
            <a class="edit-link profile-action" href={`/Portfolio/edit?id=${encodeURIComponent(id!)}`}>
              <span>{isOwnPortfolio ? "Edit my portfolio" : "Edit portfolio"}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 -2 24 24"
                aria-hidden="true"
              >
                <path
                  fill="currentColor"
                  d="M5 19h1.425L16.2 9.225L14.775 7.8L5 17.575zm-2 2v-4.25L17.625 2.175L21.8 6.45L7.25 21zM19 6.4L17.6 5zm-3.525 2.125l-.7-.725L16.2 9.225z"
                />
              </svg>
            </a>
          </div>
        )
      }

      <a href="javascript:history.back()" aria-label="Back">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="25"
          height="25"
          viewBox="0 0 20 20"
          ><path
            fill="currentColor"
            d="M11.25 17.308L5.942 12l5.308-5.308l.708.708L7.364 12l4.594 4.6zm6.1 0L12.042 12l5.308-5.308l.708.708l-4.594 4.6l4.594 4.6z"
          ></path>
        </svg>
        Portfolioへ戻る
      </a>
    </div>

    <hr class="section-divider" />

    {
      hasPictures && (
        <p class="picture-count">{portfolio.pictures.length} pictures</p>
      )
    }

    <div class="gallery-container-inner">
      {
        hasPictures && totalPages > 1 && (
          <div
            class="tab-panel-number panel-top"
            data-total-posts={portfolio.pictures.length}
            data-total-pages={totalPages}
          >
            <p class="total-pages-label">Total {totalPages}</p>

            <a class="tab-posts-navigation prev-btn-top" href="#">
              <img src="/icons/leftarrow.svg" alt="Prev" />
            </a>

            <input
              class="page-input-top"
              type="text"
              inputmode="numeric"
              min="1"
              max={totalPages}
              value="1"
            />
            <p>/</p>
            <p>{totalPages}</p>

            <a class="tab-posts-navigation next-btn-top" href="#">
              <img src="/icons/rightarrow.svg" alt="Next" />
            </a>
          </div>
        )
      }
      {
        hasPictures ? (
          <div class="justified-grid" data-page-size={ITEMS_PER_PAGE}>
            {portfolio.pictures.map((pic, i) => (
              <a
                class="photo-wrapper"
                hidden={i >= ITEMS_PER_PAGE}
                data-aspect-ratio={pic.width && pic.height ? pic.width / pic.height : undefined}
                href={optimizeMicrocmsImage(pic.url,{width:2048,quality:85})}
                data-lightbox="portfolio"
              >
                <img
                  src={optimizeMicrocmsImage(pic.url, {
                    width: 960,
                    quality: 75,
                  })}
                  alt={`${portfolio.name}の作品 ${i + 1}`}
                  decoding="async"
                  class="gallery-image"
                  loading="lazy" width={pic.width ?? 960} height={pic.height ?? 640}
                  srcset={[240,480,720,960,1440,1920].map(w => `${optimizeMicrocmsImage(pic.url,{width:w,quality:78})} ${w}w`).join(", ")}
                  sizes="(max-width:768px) 80vw, 30vw"
                />
              </a>
            ))}
          </div>
        ) : (
          <div class="no-photos">
            <p>まだ写真が投稿されていません。</p>
          </div>
        )
      }

      {
        hasPictures && totalPages > 1 && (
          <div class="tab-panel-number panel-bottom">
            <a href="#" class="tab-posts-double-navigation first-btn">
              <img src="/icons/doubleleftarrow.svg" alt="First" />
            </a>

            <a href="#" class="tab-posts-navigation prev-btn">
              <img src="/icons/leftarrow.svg" alt="Prev" />
            </a>

            <div class="tab-posts-numbers" />

            <a href="#" class="tab-posts-navigation next-btn">
              <img src="/icons/rightarrow.svg" alt="Next" />
            </a>

            <a href="#" class="tab-posts-double-navigation last-btn">
              <img src="/icons/doublerightarrow.svg" alt="Last" />
            </a>
          </div>
        )
      }
    </div>
    <div id="image-modal" class="modal-overlay" aria-hidden="true">
      <div class="modal-content">
        <button id="modal-close-btn" class="modal-close" aria-label="Close"
          >&times;</button
        >
        <img id="modal-image" src="" alt="" />
      </div>
    </div>
  </Fragment>
</Layout>

<style>
  .section-title {
    display: flex;
    flex-direction: row;
    align-items: space-between;
    justify-content: center;
    margin-bottom: 55px;
  }

  .section-title h1 {
    color: #000;
    font-family: "linotype-didot", serif;
    font-size: 96px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 14.4px;
    padding-right: 78px;
  }

  .section-title-line {
    width: 100%;
    position: relative;
  }

  .section-title-line::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    background: #000;
    position: absolute;
    top: 50%;
    right: 0;
  }

  .menu-contents-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }

  .portfolio-detail-wrapper {
    width: 100%;
    padding: 0 20px;
  }

  .profile-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .profile-info {
    max-width: calc(1 / 2 * 100vw);
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: flex-start;
  }

  .name-and-sns {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .user-name {
    color: #000;
    font-family: "Zen Old Mincho";
    font-size: calc(2 / 45 * 100vw);
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 9.6px;
    display: inline-block;
  }

  .sns {
    height: auto;
    display: flex;
    justify-content: flex-end;
    gap: 15px;
  }

  .sns a,
  .sns :global(.portfolio-share-social) {
    padding: 10px 10px 4px;
  }

  .sns a:hover,
  .sns :global(.portfolio-share-social:hover) {
    background-color: #e0dede;
  }

  .sns a:hover img,
  .sns :global(.portfolio-share-social:hover svg) {
    filter: invert(100%) sepia(100%) saturate(0%) hue-rotate(335deg)
      brightness(106%) contrast(102%);
  }

  .sns img,
  .sns :global(.portfolio-share-social svg) {
    width: 25px;
    height: 25px;
    cursor: pointer;
    filter: invert(59%) sepia(1%) saturate(380%) hue-rotate(24deg)
      brightness(103%) contrast(99%);
  }

  .tag {
    margin-right: 15px;
    color: #6f6f6f;
    font-family: "Zen Kurenaido";
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 3px;
    display: inline-block;
  }

  .icon {
    height: -webkit-fill-available;
    height: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .circle {
    position: relative;
    width: calc(5 / 24 * 100vw);
    height: calc(5 / 24 * 100vw);
    max-width: 300px;
    max-height: 300px;
    min-width: 170px;
    min-height: 170px;
    background-color: #eee;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-grade {
    color: #ffffff;
    mix-blend-mode: difference;
    font-family: "Grandiflora One";
    font-size: calc(2 / 45 * 100vw);
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 9.6px;
    position: absolute;
    bottom: 0px;
    text-align: right;
    right: 0px;
    text-shadow: 1px 1px 2px rgba(256, 256, 256, 0.3);
    display: inline-block;
    text-wrap: nowrap;
  }

  .profile-grade::first-letter {
    font-size: calc(3 / 45 * 100vw);
    position: absolute;
    top: 0;
    text-align: left;
    right: 0;
  }

  .camera-info {
    color: #000;
    font-family: "Zen Kurenaido";
    font-size: calc(1 / 72 * 100vw);
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 3px;
    border-left: 7px solid #d2d2d2;
    padding-left: 20px;
  }

  .self-introduction {
    white-space: pre-line;
    color: #000;
    font-family: "Zen Kurenaido";
    font-size: calc(1 / 72 * 100vw);
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 3px;
    border-left: 7px solid #d2d2d2;
    padding-left: 20px;
  }

  .profile-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid #ddd;
  }

  .icon .suffix {
    position: absolute;
    right: 10px;
    bottom: 0px;
    line-height: 1.1;
    font-size: 3rem;
    font-family: "Courier New", monospace;
    padding: 4px 8px;
    border-radius: 3px;
    text-align: center;
  }

  .section-divider {
    border: none;
    border-top: 1px solid #000;
    margin: 40px 0 20px;
  }

  .gallery-container-inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .picture-count {
    color: #000;
    font-family: "Grandiflora One";
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 3px;
    text-align: right;
    cursor: default;
    margin-bottom: 20px;
  }

  .tab-panel-number {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 9px;
  }

  .tab-panel-number p,
  .tab-panel-number a,
  .tab-panel-number input {
    color: #000;
    font-family: "Grandiflora One";
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 3px;
    text-align: center;
    cursor: default;
  }

  .panel-top {
    justify-content: flex-end;
    margin-bottom: 24px;
  }

  .panel-bottom {
    justify-content: center;
    margin-top: 24px;
  }

  .total-pages-label {
    margin-right: 4px;
  }

  .page-input-top {
    width: 40px;
    text-align: center;
    border: none;
    background: none;
    outline: none;
    border-bottom: 1px solid #f0f0f0;
    cursor: text !important;
  }

  .page-input-top:focus {
    width: 80px;
    border-bottom: 1px solid #0db49b;
    color: #0db49b !important;
  }

  input.page-input-top::-webkit-outer-spin-button,
  input.page-input-top::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  input.page-input-top[type="number"] {
    -moz-appearance: textfield;
  }

  .tab-posts-numbers {
    display: flex;
    gap: 10px;
    margin: 0 15px;
  }

  .tab-posts-number {
    text-decoration: none;
    cursor: pointer !important;
  }

  .tab-posts-number:hover {
    color: #0db49b;
  }

  .tab-posts-navigation {
    text-decoration: none;
    width: 20px;
    height: 20px;
  }

  .tab-posts-double-navigation {
    text-decoration: none;
    width: 26px;
    height: 20px;
  }

  .tab-posts-navigation img,
  .tab-posts-double-navigation img {
    margin-bottom: 2px;
  }

  .tab-posts-navigation:hover {
    filter: invert(56%) sepia(30%) saturate(7333%) hue-rotate(139deg)
      brightness(100%) contrast(90%);
  }

  .tab-posts-double-navigation:hover {
    filter: invert(56%) sepia(30%) saturate(7333%) hue-rotate(139deg)
      brightness(100%) contrast(90%);
  }

  .tab-posts-navigation img {
    width: 20px;
    height: 20px;
  }

  .tab-posts-double-navigation img {
    width: 26px;
    height: 20px;
  }

  .no-photos {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    color: #6f6f6f;
    font-family: "Zen Kurenaido";
    font-size: 16px;
    letter-spacing: 3px;
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
  }
  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  .modal-close {
    position: fixed;
    top: 20px;
    right: 20px;
    color: white;
    font-size: 50px;
    background: none;
    border: none;
    cursor: pointer;
  }
  #modal-image {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .back-link {
    margin-top: 48px;
    font-family: "Zen Kurenaido";
    font-size: 20px;
    letter-spacing: 3px;
    text-align: right;
    color: #6f6f6f;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    padding: 0px 20px;
    gap: 15px;
  }

  .back-link a:hover {
    color: #0db49b;
  }

  .back-link a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-left: auto;
  }

  .back-link:has(.profile-actions) {
    flex-wrap: wrap;
  }

  .profile-actions {
    display: flex;
    align-items: center;
    max-width: 100%;
    flex: none;
  }

  .profile-actions .edit-link {
    margin: 0;
    white-space: nowrap;
  }

  .profile-action svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  @media (max-width: 1200px) {
    .gallery-container-inner,
    .justified-grid {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .section-title {
      margin-bottom: 35px;
    }

    .section-title h1 {
      font-size: 48px;
      letter-spacing: 7.2px;
      padding-right: 39px;
    }

    .profile-grid {
      flex-direction: column;
      align-items: center;
    }

    .portfolio-detail-wrapper {
      padding: 0;
    }

    .profile-info {
      max-width: 100%;
    }

    .tag {
      font-size: 16px;
      margin: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 15px;
      text-align: center;
    }

    .profile-grade {
      font-size: 24px;
      position: static;
      transform: none;
      margin-top: 10px;
      margin-left: 12px;
      text-align: center;
    }

    .profile-grade::first-letter {
      font-size: 32px;
      position: static;
      transform: none;
    }

    .name-and-sns {
      flex-direction: column-reverse;
      align-items: center;
      gap: 10px;
    }

    .user-name {
      font-size: 40px;
      letter-spacing: 4px;
      text-align: center;
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .sns {
      justify-content: center;
      align-items: center;
    }

    .sns a,
    .sns :global(.portfolio-share-social) {
      padding: 8px 8px 2px;
    }

    .sns img,
    .sns :global(.portfolio-share-social svg) {
      width: 20px;
      height: 20px;
    }

    .camera-info,
    .self-introduction {
      font-size: 16px;
      padding-left: 12px;
    }

    .icon {
      order: -1;
      margin-bottom: 10px;
    }

    .back-link {
      font-size: 12px;
      letter-spacing: 2px;
      margin-top: 24px;
      padding: 0;
    }

    .back-link a {
      gap: 8px;
    }

    .back-link a svg {
      width: 16px;
      height: 16px;
    }

    .profile-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      gap: 12px;
    }

    .profile-actions .edit-link {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      margin: 0;
      white-space: nowrap;
    }

    .back-link:has(.profile-actions) > a {
      flex-basis: 100%;
      justify-content: flex-end;
    }

    .section-divider {
      margin: 24px 0 12px;
    }

    .picture-count {
      font-size: 12px;
      letter-spacing: 2px;
      margin-bottom: 12px;
    }

    .tab-panel-number {
      gap: 10px;
      font-size: 14px;
    }

    .tab-posts-numbers {
      gap: 8px;
    }

    .tab-posts-number,
    .separate-slash {
      font-size: 14px;
    }
  }
</style>

<script>
  import "../../scripts/portfolioGallery";
  import "../../scripts/portfolioLightbox";
</script>
