---
import "../../styles/PhotoGallery.css";
import PhotoCard from "../../components/PhotoCard.astro";
import LoadingIndicator from "../../components/LoadingIndicator.astro";
import GalleryLayout from "../../layouts/Gallery_Layout.astro";
import GalleryAlbumSettings from "../../components/GalleryAlbumSettings.astro";
import { isStaff } from "../../lib/auth";
import { getGalleryPhotosPage } from "../../lib/galleryCatalog";
import { accessibleAlbum } from "../../lib/galleryAccess";
import { photoLinks } from "../../lib/galleryTokens";

const { id } = Astro.params;
let album,
  page,
  failed = false;
try {
  album = await accessibleAlbum(id ?? "", Astro.locals.user);
  if (album) page = await getGalleryPhotosPage(album.id, { limit: 100, groupSeries: true });
} catch {
  failed = true;
  Astro.response.status = 503;
}
if (!failed && !album) return Astro.rewrite("/404");
if (album?.hidden) {
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex");
}
const photos = (page?.photos ?? []).map((photo) =>
  photoLinks(album!.id, photo),
);

const initialPhotos=photos;
const ITEMS_PER_PAGE=100;
const albumTitle=album?.payload.name ?? "Gallery";
const initialCursor=page?.nextCursor ?? "";
const initialTotalPages=Math.max(1,Math.ceil((initialPhotos.length + Number(Boolean(initialCursor)))/ITEMS_PER_PAGE));
---

<GalleryLayout title={albumTitle} visibility={album?.visibility}>
  {album && isStaff(Astro.locals.user) && !Astro.locals.adminView?.readOnly && <GalleryAlbumSettings slot="album-actions" album={album} />}
  {failed && <p class="service-notice" role="alert">写真を取得できません。時間をおいて再読み込みしてください。</p>}
  <p class="gallery-load-status" role="status"></p>
  {initialPhotos.length === 0 && <div class="no-photos">No photos found.</div>}
  {
    initialPhotos.length > 0 && (
      <div class="tab-panel-number panel-top">
        <p class="picture-count">
          <span class="picture-count-value">{initialPhotos.length}</span> pictures
        </p>

        <div class="top-pagination">

          <div
            class:list={[
              "pagination-controls",
              { "pagination-controls-hidden": initialTotalPages <= 1 },
            ]}
          >
            <a class="tab-posts-navigation prev-btn-top" href="#">
              <img src="/icons/leftarrow.svg" alt="Prev" />
            </a>

            <input
              class="page-input-top"
              type="text"
              inputmode="numeric"
              min="1"
              max={initialTotalPages}
              value="1"
            />
            <p>/</p>
            <p class="total-pages-value">{initialTotalPages}</p>

            <a class="tab-posts-navigation next-btn-top" href="#">
              <img src="/icons/rightarrow.svg" alt="Next" />
            </a>
          </div>
        </div>
      </div>
    )
  }
  <div class="gallery-container-inner">
    <div class="justified-grid" data-layout={initialPhotos.length ? "loading" : undefined} data-page-size={ITEMS_PER_PAGE} data-album-id={id} data-next-cursor={initialCursor}>
      <div class="photo-grid-loading" role="status"><LoadingIndicator /><span class="visually-hidden">写真一覧を読み込んでいます</span></div>
      {
        initialPhotos.map((photo, photoIndex) => (
          <PhotoCard
            photoRef={{ source: "gallery", containerId: id!, imageId: photo.id, proof: new URL(photo.full, Astro.url).searchParams.get("proof")! }}
            src={photo.src} full={photo.full} alt={photo.name}
            series={photo.series}
            width={photo.width} height={photo.height}
            aspectRatio={photo.width && photo.height ? photo.width / photo.height : undefined}
            loading={photoIndex === 0 ? "eager" : "lazy"}
            fetchPriority={photoIndex === 0 ? "high" : undefined}
          />
        ))
      }
    </div>
  </div>
  {
    initialPhotos.length > 0 && (
      <div
        class:list={[
          "tab-panel-number",
          "panel-bottom",
          { "panel-hidden": initialTotalPages <= 1 },
        ]}
      >
        <a href="#" class="tab-posts-double-navigation first-btn">
          <img src="/icons/doubleleftarrow.svg" alt="First" />
        </a>

        <a href="#" class="tab-posts-navigation prev-btn">
          <img src="/icons/leftarrow.svg" alt="Prev" />
        </a>

        <div class="tab-posts-numbers" />

        <a href="#" class="tab-posts-navigation next-btn">
          <img src="/icons/rightarrow.svg" alt="Next" />
        </a>

        <a href="#" class="tab-posts-double-navigation last-btn">
          <img src="/icons/doublerightarrow.svg" alt="Last" />
        </a>
      </div>
    )
  }
</GalleryLayout>

<style is:global>
  .gallery-container-inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
  }

  .tab-panel-number {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 9px;
  }

  .tab-panel-number p,
  .tab-panel-number a,
  .tab-panel-number input {
    color: #000;
    font-family: "Grandiflora One";
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 3px;
    text-align: center;
    cursor: default;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pagination-controls-hidden {
    display: none;
  }

  .top-pagination {
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }

  .panel-top {
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .picture-count {
    text-align: left !important;
  }

  .panel-bottom {
    justify-content: center;
    margin-top: 24px;
  }

  .panel-hidden {
    display: none;
  }

  .page-input-top {
    width: 40px;
    text-align: center;
    border: none;
    background: none;
    outline: none;
    border-bottom: 1px solid #f0f0f0;
    cursor: text !important;
  }

  .page-input-top:focus {
    width: 80px;
    border-bottom: 1px solid #0db49b;
    color: #0db49b !important;
  }

  input.page-input-top::-webkit-outer-spin-button,
  input.page-input-top::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input.page-input-top[type="number"] {
    -moz-appearance: textfield;
  }

  .tab-posts-numbers {
    display: flex;
    gap: 10px;
    margin: 0 15px;
  }

  .tab-posts-number {
    text-decoration: none;
    cursor: pointer !important;
  }

  .tab-posts-number:hover {
    color: #0db49b;
  }

  .tab-posts-navigation {
    text-decoration: none;
    width: 20px;
    height: 20px;
  }

  .tab-posts-double-navigation {
    text-decoration: none;
    width: 26px;
    height: 20px;
  }

  .tab-posts-navigation img,
  .tab-posts-double-navigation img {
    margin-bottom: 2px;
  }

  .tab-posts-navigation:hover {
    filter: invert(56%) sepia(30%) saturate(7333%) hue-rotate(139deg)
      brightness(100%) contrast(90%);
  }

  .tab-posts-double-navigation:hover {
    filter: invert(56%) sepia(30%) saturate(7333%) hue-rotate(139deg)
      brightness(100%) contrast(90%);
  }

  .tab-posts-navigation img {
    width: 20px;
    height: 20px;
  }

  .tab-posts-double-navigation img {
    width: 26px;
    height: 20px;
  }

  @media screen and (max-width: 780px) {
    .tab-panel-number {
      gap: 10px;
      font-size: 14px;
    }

    .panel-top {
      margin-bottom: 16px;
      flex-direction: column;
      align-items: flex-start;
      padding: 0;
    }

    .tab-panel-number p {
      font-size: 12px;
      letter-spacing: 2px;
      text-align: right;
    }

    .tab-posts-numbers {
      gap: 8px;
    }

    .tab-posts-number,
    .separate-slash {
      font-size: 14px;
    }

    .pagination-controls {
      gap: 8px;
    }

    .top-pagination {
      width: 100%;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .pagination-controls img {
      width: 16px;
      height: 16px;
    }

    .pagination-controls .page-input-top {
      width: 30px;
      font-size: 14px;
    }

    .pagination-controls .page-input-top:focus {
      width: 50px;
      font-size: 14px;
    }

    .pagination-controls p {
      font-size: 14px;
    }
  }
</style>

<script>
  import "../../scripts/portfolioGallery";

</script>
