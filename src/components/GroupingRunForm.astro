---
import { displayName } from "../lib/groupPresentation";
import { isExecutive } from "../lib/auth";
import GroupingParticipantImport from "./GroupingParticipantImport.astro";
import { activeGuests, rosterParticipants, type GroupingParticipant } from "../lib/groupingParticipants";
import ActivityRecipients from "./ActivityRecipients.astro";
import type { ActivityStore } from "../lib/activityTypes";
import { activityDate } from "../lib/activityTypes";
import type { GroupingRun, GroupingTools } from "../lib/groupingTools";
interface Props {
  activities: ActivityStore;
  data: GroupingTools;
  run?: GroupingRun;
}
const { activities, data, run } = Astro.props;
const records = activities.roster?.records || [];
const available = records.filter((r) => r.active && r.gender && r.grade);
const candidates = [...new Map<string, GroupingParticipant>([...rosterParticipants(activities), ...activeGuests(data.guests), ...(run?.guests || [])].map(p => [p.id, p])).values()];
const choices = candidates.map(p => ({
  id: p.id, name: displayName(p), grade: p.grade,
  group: run?.participantSources?.[p.id] ?? p.inputSource ?? (p.id.startsWith("guest-") ? "legacy" : "roster"),
}));
for (const id of run?.participantIds || [])
  if (!choices.some((r) => r.id === id))
    choices.push({
      id,
      grade: undefined!,
      group: "roster",
      name: `${displayName(records.find((r) => r.key === id) || { name: "名簿から削除されたメンバー" })}（継続状態・性別・学年の確認が必要）`,
    });
const previous = data.runs
  .filter((r) => r.id !== run?.id && r.publishedGroups)
  .sort((a, b) =>
    b.publishedGroups!.publishedAt.localeCompare(
      a.publishedGroups!.publishedAt,
    ),
  );
if (
  run?.previousSnapshot &&
  run.previousSnapshot.id === run.previousRunId &&
  !previous.some((r) => r.id === run.previousRunId)
) {
  previous.push({
    ...run,
    ...run.previousSnapshot,
    title: `${run.previousSnapshot.title}（削除済み・参照履歴）`,
  });
}
const selectedPrevious = run?.previousRunId ?? previous[0]?.id ?? "";
const participantGroups = [
  { id: "event", title: "企画の参加投票から読み込んだ参加者" },
  { id: "sheet", title: "スプレッドシートで追加した参加者" },
  { id: "manual", title: "手入力で追加した参加者" },
  { id: "roster", title: "所属名簿の参加者候補" },
];
if (choices.some(choice => choice.group === "legacy"))
  participantGroups.push({ id: "legacy", title: "追加方法の記録がない参加者" });
---

<p>
  企画の参加投票、スプレッドシート、手入力から参加者を追加できます。所属名簿や保存済みの参加者からも選べます。
</p>
<p>
  {
    activities.roster
      ? `名簿の最終取得：${activityDate(activities.roster.fetchedAt)} · 選択可能 ${available.length}人`
      : "所属名簿は未取得です。フォームの読み込みや名前入力でも参加者を追加できます。"
  }
  {isExecutive(Astro.locals.user) && <a href="/Admin/grouping-roster">名簿</a>}
</p>
{
  records.some((r) => r.active && (!r.gender || !r.grade)) && (
    <p class="activity-warning">
      性別・学年が未確認のメンバーは選択できません。管理者が元のGoogle名簿を確認・更新してください。
    </p>
  )
}
<div data-grouping-participants data-candidates={JSON.stringify(candidates)}>
<p>追加参加者は最後に利用してから3か月間、別の班分けでも選択できます。期限後も保存済みの班分けには記録が残ります。</p>
<GroupingParticipantImport events={activities.events.filter(event => event.status === "published")} />
<form
  class="activity-form"
  data-activity-action="run.save"
  data-endpoint="/api/member/grouping"
  data-run-id={run?.id}
  data-revision={run?.revision}
  data-participant-sources={JSON.stringify(run?.participantSources ?? {})}
  data-redirect="/Member/manage/grouping/{runId}"
>
  <label
    >班分け名<input
      name="title"
      value={run?.title}
      maxlength="200"
      required
      placeholder="例：10月の撮影会"
    /></label
  >
  <ActivityRecipients
    users={choices}
    selected={run?.participantIds || []}
    legend="参加者"
    fieldName="participantIds"
    groups={participantGroups}
  />
  <label
    >前回の班分け<select name="previousRunId" aria-label="前回の班分け"
      ><option value="" selected={!selectedPrevious}>参照しない</option>{
        previous.map((p) => (
          <option value={p.id} selected={selectedPrevious === p.id}>
            {p.title}（{activityDate(p.publishedGroups!.publishedAt)}確定）
          </option>
        ))
      }</select
    ></label
  >
  <p>
    前回と同じ組合せをできるだけ減らします。参加者や条件によって、同じ組合せが残る場合があります。
  </p>
  <button type="submit" class="member-submit"
    >{run ? "参加者・履歴を保存" : "参加者を保存して班分けへ"}</button
  >
  <p data-status role="status" aria-live="polite"></p>
</form>

</div>
