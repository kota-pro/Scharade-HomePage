---
import { activityTextParts } from "../lib/activityPresentation";
import { activityRichHtml } from "../lib/activityRichText";
import "../styles/PortfolioIntroduction.css";
import "../styles/RichBody.css";
interface Props {
  text: string;
  html?: string;
}
const { text, html } = Astro.props;
---

{
  html ? <div class="portfolio-introduction-content rich-body-content" set:html={activityRichHtml(html)} /> : activityTextParts(text).map((part) =>
    part.href ? (
      <a href={part.href} target="_blank" rel="noopener noreferrer">
        {part.text}
      </a>
    ) : (
      part.text
    ),
  )
}
