---
import SearchIcon from "./SearchIcon.astro";
import '../styles/UA+reset.css';
const pathname = Astro.url.pathname;
import { isExecutive, isStaff } from "../lib/auth";
import { getContent } from "../lib/siteContent";
const common = getContent("common", Astro.locals.preview);
const user = Astro.locals.user;
const profileUrl = user?.portfolioId ? `/Portfolio/${encodeURIComponent(user.portfolioId)}` : "/Portfolio/edit";
---

<header id="header">
    <a href="/"><div class="header-logo" id="header-logo">
        <img src="/icons/logo.svg" alt="Scharade Logo" class="header-logo-svg">
        <div class="header-logo-text">
            <p class="header-logo-text">{common.affiliation}</p>
            <p class="header-logo-text">{common.name}</p>
        </div>
    </div></a>
    <div class="header-nav" id="header-nav" role="navigation" aria-label="メインナビゲーション">
        {!user && <a class:list={['link', {active: /^\/About_us\/?$/.test(pathname)}]} href="/About_us">About us</a>}
        <a class:list={['link', {active: /^\/Activity(?:\/.*)?$/.test(pathname)}]} href="/Activity">Activity</a>
        <a class:list={['link', {active: /^\/Gallery(?:\/.*)?$/.test(pathname)}]} href="/Gallery">Gallery</a>
        <a class:list={['link', {active: /^\/Portfolio(?:\/.*)?$/.test(pathname)}]} href="/Portfolio">Portfolio</a>
        {user ? <>
          <a class:list={['link', {active: /^\/Member(?:\/.*)?$/.test(pathname) && !pathname.startsWith('/Member/manage')}]} href="/Member">Member</a>
          {isStaff(user) ? <a class:list={['link', {active: /^\/Dashboard\/?$/.test(pathname)}]} href="/Dashboard">Dashboard</a> : <button type="button" class="link" id="header-logout" data-header-logout>Log out</button>}
        </> : <a class:list={['link', {active: /^\/Contact\/?$/.test(pathname)}]} href="/Contact">Contact</a>}
    </div>
    <div class="hamburger-menu" id="hamburger-menu">
        <nav id="site-menu" aria-label="サイトメニュー">
            <div class="menu-title">
                <h1>Menu</h1>
                <div class="sns">
                    <a href={common.x} target="_blank" rel="noopener noreferrer" class="none-underline">
                        <img src="/icons/X.svg" alt="X">
                    </a>
                    <a href={common.instagram} target="_blank" rel="noopener noreferrer" class="none-underline">
                        <img src="/icons/Instagram.svg" alt="Instagram">
                    </a>
                </div>
            </div>
            <div class="inner">
                <div class = "sbox"> 
                    <div class = "sbox-inner"> 
                        <input type="search" id="searchbox" placeholder="Search..." aria-label="サイト内検索" maxlength="100">
                        <button id="searchbutton" aria-label="検索">
                            <SearchIcon />
                        </button>
                    </div>
                </div>
                <ul>
                    <li><a class:list={['link', {active: /^\/About_us\/?$/.test(pathname)}]} href="/About_us">About&nbsp;us</a></li>
                    <li><a class:list={['link', {active: /^\/Activity(?:\/.*)?$/.test(pathname)}]} href="/Activity">Activity</a></li>
                    <li><a class:list={['link', {active: /^\/Gallery(?:\/.*)?$/.test(pathname)}]} href="/Gallery">Gallery</a></li>
                    <li><a class:list={['link', {active: /^\/Portfolio(?:\/.*)?$/.test(pathname)}]} href="/Portfolio">Portfolio</a></li>
                    <li><a class:list={['link', {active: /^\/Contact\/?$/.test(pathname)}]} href="/Contact">Contact</a></li>
                    <li><a class:list={['link', {active: /^\/Disclaimer\/?$/.test(pathname)}]} href="/Disclaimer">Disclaimer</a></li>
                </ul>
                <div class="member-area">
                    <p>Member&nbsp;only</p>
                    <div class="member-buttons">
                        {user ? <>
                          {isExecutive(user) && <a href="/Admin" class="member-button">Admin</a>}
                          {isStaff(user) && <a href="/Management" class="member-button">Management</a>}
                          <a href="/Member" class="member-button">Member</a>
                          {!user.siteManagement && <a href={profileUrl} class="member-button">My Portfolio</a>}
                          <button type="button" id="logout-button" class="member-button" data-header-logout>Log out</button>
                          <p id="logout-status" role="status"></p>
                        </> : <>
                          <a href="/Login" class="member-button">Log&nbsp;in</a>
                          <a href="/Signup" class="member-button">Sign&nbsp;up</a>
                        </>}
                    </div>
                </div>
            </div>
        </nav>
        <button type="button" class="toggle_btn" aria-label="メニューを開く" aria-expanded="false" aria-controls="site-menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div id="mask"></div>
    </div>
</header>

<script>
  import { operationNotice, flashNotice } from "../scripts/siteNotice";
 const initializeHeader = () => {
  const body = document.body;
  const button = document.querySelector<HTMLButtonElement>(".toggle_btn");
  const menu = document.querySelector<HTMLElement>("#site-menu");
  if (!button || !menu) return;
  const setOpen = (open: boolean) => {
    body.classList.toggle("open", open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    menu.inert = !open;
    if (open && !matchMedia('(max-width: 768px), (pointer: coarse)').matches) menu.querySelector<HTMLElement>("#searchbox")?.focus({preventScroll:true});
    else button.focus({preventScroll:true});
  };
  menu.inert = true;
  button.addEventListener("click", () => setOpen(!body.classList.contains("open")));
  document.querySelector("#mask")?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", event => {
    if (!body.classList.contains("open")) return;
    if (event.key === "Escape") {
      event.preventDefault();
      setOpen(false);
    } else if (event.key === "Tab") {
      const focusable = [...menu.querySelectorAll<HTMLElement>('a[href], input, button, select, textarea, [tabindex]')]
        .filter(element => element.tabIndex >= 0 && !element.matches(":disabled") && element.getClientRects().length > 0);
      focusable.push(button);
      const index = focusable.indexOf(document.activeElement as HTMLElement);
      const next = event.shiftKey
        ? (index <= 0 ? focusable.length - 1 : index - 1)
        : (index + 1) % focusable.length;
      event.preventDefault();
      focusable[next].focus();
    }
  });
  const updateScroll = () => {
   for (const id of ["header", "header-logo", "header-nav", "hamburger-menu"]) document.getElementById(id)?.classList.toggle("scrolled", window.scrollY > 120);
  };
  updateScroll(); window.addEventListener("scroll", updateScroll, {passive:true});
  document.querySelectorAll(".sbox").forEach(box => {
    const input = box.querySelector<HTMLInputElement>("#searchbox");
    const search = () => { if(input?.value.trim()) location.href = `/SearchResult?q=${encodeURIComponent(input.value.trim())}` };
    box.querySelector("#searchbutton")?.addEventListener("click", search);
    input?.addEventListener("keydown", event => {if(event.key === "Enter") {event.preventDefault();search();}});
  });
  const logoutButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-header-logout]")];
  let loggingOut = false;
  logoutButtons.forEach(target => target.addEventListener("click", async () => {
   if (loggingOut) return;
   loggingOut = true;
   logoutButtons.forEach(button => button.disabled = true);
   const status = document.querySelector("#logout-status");
   if (status) status.textContent = "";
   operationNotice("ログアウトしています…", false, "logout");
   try {
     const response = await fetch("/api/auth/logout", { method: "POST" });
     if (!response.ok) throw new Error();
     flashNotice("ログアウトしました。");
     location.assign("/");
   } catch {
     const message = "ログアウトできませんでした。再度お試しください。";
     if (status) status.textContent = message;
     operationNotice(message, true, "logout");
     loggingOut = false;
     logoutButtons.forEach(button => button.disabled = false);
   }
  }));
 };
 if(document.readyState === "loading") document.addEventListener("DOMContentLoaded",initializeHeader,{once:true}); else initializeHeader();
</script>

<style>
    header {
        top:0;
        width: 100vw;
        height: 8.3vw;
        min-height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 max(21px, 8.33vw) 0 var(--site-inline-gutter);
        box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
        background: #fff;
        position: fixed;
        z-index: 100 !important;
    }

    header.scrolled {
        /* backdrop-filter: blur(12px); */
        background: rgba(255, 255, 255, 1);
    }

    body.open header.scrolled {
        /* backdrop-filter: initial; */
        background: rgba(255, 255, 255, 1);
    }

    .header-logo {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 23.5vw;
        height: 4.2vw;
        min-width: 144px;
        min-height: 24px;
        gap: 20px;
    }

    .header-logo:active {
        filter: invert(45%) sepia(95%) saturate(720%) hue-rotate(132deg) brightness(97%) contrast(90%);
    }

    .header-logo-svg {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 5.25vw;
        height: 3.93vw;
        min-width: 32.053px;
        min-height: 24px;
    }

    .header-logo-text:first-child {
        font-family: YakuHanMP, "Zen Old Mincho", serif;
        font-size: max(5px, 0.9vw);
        margin: 0;
    }

    .header-logo-text:last-child {
        font-family: YakuHanMP, "Zen Old Mincho", serif;
        font-size: max(14px, 2.22vw);
        margin: 0;
    }

    .header-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header-nav.scrolled {
        display: none;
    }

    .header-nav :is(a, button) {
        font-family: "Zen Old Mincho", serif;
        font-size: 20px;
        text-decoration: none;
        color: #000;
        padding: 15px;
        letter-spacing: 3px;
        position: relative; /* アンダーラインのために相対位置を指定 */
        cursor: pointer;
    }

    .header-nav button { border: 0; border-radius: 0; margin: 0; background: transparent; }
    .header-nav button:disabled { opacity: .5; cursor: wait; }

    .header-nav :is(a, button)::after {
        position: absolute;
        left: 15px; /* aタグの左端からアンダーラインを引く */
        right: 15px; /* aタグの右端からアンダーラインを引く */
        content: '';
        width: calc(100% - 30px);
        height: 1px;
        background: #000000;
        bottom: 12px;
        transform: scale(0, 1);
        transform-origin: center top; /*変形（アンダーラインの伸長）の原点がaタグ（各メニュー）の右端*/
        transition: transform 0.3s;   /*変形の時間*/
    }

    .header-nav :is(a, button):hover::after {
        transform: scale(1, 1); /* アンダーラインを表示 */
    }

    .header-nav :is(a, button):focus {
        color: #0db49b;
    }

    .header-nav :is(a, button):focus::after {
        background-color: #0db49b;
    }

    .link.active {
        color: #0db49b !important;
    }

    .link.active::after {
        background-color: #0db49b !important;
    }

    .link:focus {
        color: #0db49b !important;
    }

    .link:focus::after {
        background-color: #0db49b !important;
    }

    .hamburger-menu {
        display: none;
        pointer-events: none;
    }

    .hamburger-menu.scrolled {
        display: flex;
        align-items: center;
        justify-content: space-between;
        pointer-events: auto;
    }

    #site-menu a:not(.none-underline):not(.member-button) {
        font-family: "Zen Old Mincho", serif;
        font-size: 20px;
        text-decoration: none;
        color: #000;
        padding: 15px;
        letter-spacing: 3px;
        position: relative; /* アンダーラインのために相対位置を指定 */
        cursor: pointer;
    }

    #site-menu a:not(.none-underline):not(.member-button)::after {
        position: absolute;
        left: 15px; /* aタグの左端からアンダーラインを引く */
        right: 15px; /* aタグの右端からアンダーラインを引く */
        content: '';
        width: calc(100% - 30px);
        height: 1px;
        background: #000000;
        bottom: 12px;
        transform: scale(0, 1);
        transform-origin: center top; /*変形（アンダーラインの伸長）の原点がaタグ（各メニュー）の右端*/
        transition: transform 0.3s;   /*変形の時間*/
    }

    #site-menu a:not(.none-underline):not(.member-button):hover::after {
        transform: scale(1, 1); /* アンダーラインを表示 */
    }


    /*============
    nav
    =============*/
    nav {
        display: block;
        position: fixed;
        top: 0;
        right: 0;
        clip-path: inset(0 0 0 100%);
        bottom: 0;
        width: 550px;
        background: #ffffff;
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        transition: clip-path .5s, opacity .5s, visibility 0s .5s;
        z-index: 6;
        opacity: 0;
        visibility: hidden;
    }

    body.open nav {
        right: 0;
        clip-path: inset(0);
        opacity: 1;
        visibility: visible;
        transition-delay: 0s;
    }

    .menu-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 40px;
        margin-bottom: 30px;
    }

    .menu-title h1 {
        color: #000;
        font-family: Didot;
        font-size: 96px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 14.4px;
    }

    .sns {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-right: 50px;
    }

    .sns a {
        padding: 10px 10px 4px;
    }

    .sns a:hover {
        background-color: #e0dede;
    }

    .sns a:hover img {
        filter: invert(100%) sepia(100%) saturate(0%) hue-rotate(335deg) brightness(106%) contrast(102%);
    }

    .sns img {
        width: 25px;
        height: 25px;
        cursor: pointer;
        filter: invert(59%) sepia(1%) saturate(380%) hue-rotate(24deg) brightness(103%) contrast(99%);
    }

    nav .inner {
        padding: 0 78px;
        display: flex;
        flex-direction: column;
    }

    .sbox {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

    .sbox-inner {
        width: 394px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 100 !important;
        border: 0.3px solid #000;
    }

    .sbox-inner input {
        border: none;
        outline: none;
        height: 100%;
        padding-left: 20px;
    }

    .sbox-inner input#searchbox {
        flex: auto;
    }

    .sbox-inner button {
        border: none;
        outline: none;
        background: none;
        cursor: pointer;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
    }

    .sbox-inner button:active {
        background: rgba(0, 0, 0, 0.1);
    }

    nav .inner ul {
        list-style: none;
        margin: 0;
        padding: 0;
        margin-bottom: 40px;
    }

    nav .inner ul li {
        position: relative;
        margin: 0;
        /* border-bottom: 1px solid #333; */
    }

    nav .inner ul li a {
        display: block;
        color: #000000;
        font-size: 14px;
        padding: 1em;
        text-decoration: none;
        transition-duration: 0.2s;
    }

    .member-area {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 20px;
    }

    .member-area p {
        color: #000;
        font-family: "Grandiflora One";
        font-size: 15px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 2.25px;
        margin-bottom: 15px;
    }

    .member-buttons {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .member-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-width: 0;
        min-height: 48px;
        max-width: 100%;
        padding: 10px 12px;
        background-color: #ffffff;
        color: #000000;
        text-decoration: none;
        font-family: "Zen Old Mincho", serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 1.5;
        letter-spacing: 1.5px;
        border: #000000 1px solid;
        border-radius: 0;
        white-space: nowrap;
        cursor: pointer;
    }

    .member-button:not(:disabled):hover {
        background-color: #707070; /* ホバー時の背景色 */
        color: #ffffff; /* ホバー時の文字色 */
        transition: 0.3s ease-in-out; /* ホバー時の変化をスムーズに */
    }

    .member-button:focus-visible {
        outline: 2px solid #000;
        outline-offset: 4px;
    }

    .member-button:disabled {
        opacity: 0.5;
        cursor: wait;
    }

    #logout-status {
        grid-column: 1 / -1;
        margin: 0;
        font: 14px/1.7 "Zen Kurenaido", sans-serif;
        letter-spacing: 1px;
        text-align: center;
    }

    #logout-status:empty {
        display: none;
    }

    #logout-button:nth-child(odd) {
        grid-column: 1 / -1;
    }

    @media screen and (max-width: 767px) {
        nav {
            width: 100vw;
            height: 100vh;
        }

        nav .inner {
            padding: 0 20px;
        }

        .sns {
            margin-right: 20px;
            gap: 10px;
        }

        .sns a {
            padding: 6px 6px 0px;
        }

        .sns img {
            width: 20px;
            height: 20px;
        }
    }
    /*============
    .toggle_btn
    =============*/
    .toggle_btn {
        display: block;
        position: fixed;
        top: max(2.6vw, 20px);
        right: max(3.47vw, 20px);
        width: max(3vw, 20px);
        height: max(3vw, 20px);
        transition: all .5s;
        cursor: pointer;
        z-index: 4;
    }
    body.open .toggle_btn {
        right: max(41.33vw, 595px);
        width: 45px;
        height: 45px;
    }
    .toggle_btn span {
        display: block;
        position: absolute;
        left: 0;
        width: max(3.125vw, 20px);
        height: 1px;
        background-color: #000000;
        filter: drop-shadow(4px 4px 4px rgba(0, 0, 0, 0.25));
        transition: all .5s;
    }

    .toggle_btn span:nth-child(1) {
        top: 11.1%;
    }
    .toggle_btn span:nth-child(2) {
        top: 48.8%;
    }
    .toggle_btn span:nth-child(3) {
        bottom: 11.1%;
    }

    body.open .toggle_btn span {
        background-color: #fff;
    }

    body.open .toggle_btn span:nth-child(1), body.open .toggle_btn span:nth-child(3) {
        width: 20px;
    }

    body.open .toggle_btn span:nth-child(2) {
        width: 30px;
    }

    body.open .toggle_btn span:nth-child(1) {
        -webkit-transform: translate(25px,10px) rotate(45deg);
        transform: translate(25px,10px) rotate(45deg);
    }
    body.open .toggle_btn span:nth-child(3) {
        -webkit-transform: translate(25px,-10px) rotate(-45deg);
        transform: translate(25px,-10px) rotate(-45deg);
    }
    @media screen and (max-width: 767px) {
        body.open .toggle_btn {
            right: 20px;
        }

        .toggle_btn {
            z-index: 100 !important;
        }

        body.open .toggle_btn span {
            background-color: #000;
        }
    }
    /*============
    #mask
    =============*/
    #mask {
        display: none;
        transition: all .5s;
    }
    body.open #mask {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000;
        opacity: .8;
        z-index: 2;
        cursor: pointer;
    }
    /*============
    container
    =============*/
    .open container {
        margin-left: 300px;
    }
    /*============
    body
    =============*/
    body.open {
        overflow: hidden;
    }

    @media screen and (max-width: 430px) {
        header {
            padding: 0 var(--site-inline-gutter);
            height: 50px;
        }

        .header-logo {
            width: 144px;
            height: 26px;
            gap: 13px;
        }

        .header-logo-svg {
            width: 32.05px;
            height: 24px;
        }

        .header-logo-text:first-child {
            font-size: 5px;
        }

        .header-logo-text:last-child {
            font-size: 14px;
        }
    }

    @media screen and (max-width: 423px) {
        .menu-title h1 {
            font-size: 80px;
        }
    }

    /*============
    レスポンシブ対応
    =============*/
    @media screen and (max-width: 1200px) {
        .header-nav {
            display: none;
        }

        .hamburger-menu {
            display: flex;
            pointer-events: auto;
        }

        .header-logo {
            gap: 13px;
        }
    }

    /* Keep destinations visible in the available phone viewport. Overflow
       remains available for enlarged text and the search keyboard. */
    @media (max-width: 767px), (max-height: 550px) {
        #site-menu {
            --menu-block-inset: clamp(18px, 4dvh, 44px);
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            width: 100vw;
            max-width: 100vw;
            padding: max(var(--menu-block-inset), env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) max(var(--menu-block-inset), env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));
            overscroll-behavior: contain;
        }
        body.open .toggle_btn { top: max(clamp(18px, 4dvh, 44px), env(safe-area-inset-top)); right: max(20px, env(safe-area-inset-right)); z-index: 100; }
        body.open .toggle_btn span { background-color: #000; }
        .menu-title { min-height: 44px; margin: 0 0 8px; padding-right: 56px; gap: 8px; }
        .menu-title h1 { margin: 0; font-size: clamp(32px, 10vw, 48px); line-height: 1.15; letter-spacing: .12em; }
        .sns { margin: 0; gap: 4px; flex-shrink: 0; }
        .sns a { width: 44px; height: 44px; padding: 0; display: grid; place-items: center; }
