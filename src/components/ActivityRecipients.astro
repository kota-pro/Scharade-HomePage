---
import { readUsers } from "../lib/auth.ts";
import { isSiteManagement } from "../lib/accountVisibility.ts";
import { readActivities } from "../lib/activities.ts";
import { notificationRecipient, notificationGradeOptions } from "../lib/notificationRecipients.ts";
import { displayName } from "../lib/groupPresentation.ts";
import { gradeLabels, type Grade } from "../lib/activityTypes.ts";
interface Props {
  users: { id: string; name: string; grade?: Grade; group?: string }[];
  selected?: string[];
  disabled?: boolean;
  legend?: string;
  fieldName?: string;
  groups?: { id: string; title: string }[];
}
const {
  users,
  selected = users.map((u) => u.id),
  disabled = false,
  legend = "通知先",
  fieldName = "recipientIds",
  groups,
} = Astro.props;
const activities = readActivities();
const hiddenIds = new Set(readUsers().filter(isSiteManagement).map(user => user.id));
const recipients = users.filter(user => !hiddenIds.has(user.id)).map(user => ({
  ...notificationRecipient(user, activities),
  group: user.group,
  ...(user.grade && Object.hasOwn(gradeLabels, user.grade) ? { grade: user.grade, gradeLabel: gradeLabels[user.grade] } : {}),
}));
const sections = groups ?? [{ id: "", title: "" }];
---

<fieldset class="activity-recipients" disabled={disabled}>
  <legend>{legend}</legend>
  <div class="activity-actions">
    <button type="button" data-select-recipients="all">全選択</button
    ><button type="button" data-select-recipients="none">全解除</button>
  </div>
  <label>学年別選択<select data-recipient-grade><option value="">すべての学年</option>{notificationGradeOptions.map(([value,label]) => <option value={value}>{label}</option>)}<option value="unknown">学年未設定</option></select></label>
  <div class="activity-actions"><button type="button" data-select-recipients="grade-all">この学年を選択</button><button type="button" data-select-recipients="grade-none">この学年を解除</button></div>
  <label
    >メンバーを検索<input
      type="search"
      data-recipient-search
      placeholder="氏名・LINE名で検索"
    /></label
  >
  <p data-recipient-count role="status" aria-live="polite"></p>
  {sections.map(section => {
    const options = groups ? recipients.filter(u => u.group === section.id) : recipients;
    return (
      <div class:list={{ "activity-recipient-group": !!groups }} data-recipient-group={groups ? section.id : undefined}>
        {groups && <h4>{section.title}</h4>}
        {groups && <p data-recipient-empty hidden={options.length > 0}>該当する参加者はいません。</p>}
        <div class="activity-recipient-options">
      {options.map((u) => (
        <label class="activity-check" data-recipient-name={displayName(u)} data-recipient-grade={u.grade}>
          <input
            type="checkbox"
            name={fieldName}
            value={u.id}
            data-recipient-id={u.id}
            checked={selected.includes(u.id)}
          />
          {displayName(u)}（{u.gradeLabel}）
        </label>
      ))}
        </div>
      </div>
    );
  })}
</fieldset>

<style is:global>
  .activity-recipient-group { min-width: 0; border-top: 1px solid #ddd; padding-top: 14px; margin-top: 18px; }
  .activity-recipient-group h4 { margin: 0; }
  .activity-recipient-group [data-recipient-empty] { margin: 8px 0 0; color: #555; }
  .activity-recipient-group .activity-recipient-options { margin-top: 8px; }
  .activity-recipient-group .activity-recipient-options:not(:has(.activity-check:not([hidden]))) { display: none; }
</style>
