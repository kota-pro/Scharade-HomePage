---
import "../styles/Exhibitions.css";
import {exhibitionLoadingHtml} from '../scripts/exhibitionLoading.ts';
interface Props { id: string; view: "overview" | "form" | "layout" | "submissions" | "participants" }
const { id, view } = Astro.props;
---
<section class="exhibition-page" id="exhibition-admin" data-exhibition-id={id} data-exhibition-view={view} data-owner-id={Astro.locals.user?.id}>
  <p><a class="member-back" href="/Member/manage/exhibitions">写真展一覧へ戻る</a></p>
  <Fragment set:html={exhibitionLoadingHtml()} />
</section>
<script>import "../scripts/exhibitionAdmin.ts";</script>
