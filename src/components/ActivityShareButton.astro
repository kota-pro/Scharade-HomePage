---
import Icon from "./PortfolioShareIcon.astro";
interface Props { title: string; id: string; kind: "events" | "notifications" | "tools" | "exhibitions"; eventId?: string; toolId?: string; href?: string; }
const { title, id, kind, eventId, toolId, href } = Astro.props;
const shareKind = toolId ? "tools" : eventId ? "events" : kind;
const shareId = toolId || eventId || id;
const url = new URL(href ?? `/Member/${shareKind}/${encodeURIComponent(shareId)}`, Astro.site).href;
---
<button type="button" class="portfolio-share-trigger activity-share-trigger"
  data-activity-share-open data-share-kind={shareKind} data-share-url={url} data-share-title={title}
  aria-label={`${title}を共有`} aria-haspopup="dialog" aria-controls="activity-share-dialog"
  title="リンクを共有" hidden><Icon kind="share" /></button>
