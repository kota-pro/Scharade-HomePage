---
import Icon from "./PortfolioShareIcon.astro";
interface Props { title: string; id: string; kind: "events" | "notifications"; eventId?: string; }
const { title, id, kind, eventId } = Astro.props;
const shareKind = eventId ? "events" : kind;
const shareId = eventId || id;
const url = new URL(`/Member/${shareKind}/${encodeURIComponent(shareId)}`, Astro.site).href;
---
<button type="button" class="portfolio-share-trigger activity-share-trigger"
  data-activity-share-open data-share-kind={shareKind} data-share-url={url} data-share-title={title}
  aria-label={`${title}を共有`} aria-haspopup="dialog" aria-controls="activity-share-dialog"
  title="リンクを共有" hidden><Icon kind="share" /></button>
