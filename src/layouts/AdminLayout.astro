---
import PageTopNav from "../components/PageTopNav.astro";
import Layout from "./Layout.astro";
import type { BreadcrumbItem } from "../lib/breadcrumbs";
import "../styles/Admin.css";
import "../styles/PrivateMobile.css";

interface Props {
  title: string;
  breadcrumbs?: BreadcrumbItem[];
  heading?: string;
  pageClass?: string;
  memberArea?: "staff" | "admin";
  wideContent?: boolean;
}
const { title, breadcrumbs, heading = "Admin", pageClass = "", memberArea = "admin", wideContent } = Astro.props;
---

<Layout title={title} breadcrumbs={breadcrumbs} memberArea={memberArea} wideContent={wideContent}>
  <div slot="main-slot" class:list={["admin-title", { "admin-title-wide": heading === "Management" || heading === "Dashboard" }]}>
    <h1>{heading}</h1>
    <div class="admin-title-line" aria-hidden="true"></div>
  </div>
  <Fragment slot="body-slot"><div class:list={["admin-page", pageClass]}><slot /></div><slot name="body-after" /></Fragment>
  <div slot="menu-slot" class="admin-menu">
    <PageTopNav />
  </div>
</Layout>

<style>
  @media (min-width: 769px) {
    .admin-title-wide h1 { font-size: clamp(48px, 8vw, 96px); letter-spacing: .15em; padding-right: clamp(24px, 6vw, 78px); }
  }
</style>
