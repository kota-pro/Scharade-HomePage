---
import AdminLayout from "./AdminLayout.astro";
import ActivityShareDialog from "../components/ActivityShareDialog.astro";
import "../styles/Member.css";
import "../styles/Activities.css";
interface Props { title: string; wideContent?: boolean }
const { title, wideContent } = Astro.props;
---

<AdminLayout title={title} heading="Management" memberArea="staff" pageClass="staff-page" wideContent={wideContent}>
  <noscript><p class="member-notice">通知・投票・保存操作にはJavaScriptを有効にしてください。</p></noscript>
  <slot />
  <ActivityShareDialog slot="body-after" />
</AdminLayout>
<script>
  import "../scripts/activities";
</script>
