---
import PageTopNav from "../components/PageTopNav.astro";
import Layout from "./Layout.astro";
import MemberIcon from "../components/MemberIcon.astro";
import type { GalleryVisibility } from "../lib/gallerySettings";
import "../styles/UA+reset.css";
import "../styles/Gallery.css";

interface Props { title: string; visibility?: GalleryVisibility }
const { title, visibility = "public" } = Astro.props;
const audience = visibility === "staff" ? "運営限定" : "会員限定";
---

<Layout title={title}>
  <Fragment slot="main-slot">
    <div class="section-title">
      <h1>Gallery</h1>
      <div class="section-title-line"></div>
    </div>
  </Fragment>
  <Fragment slot="menu-slot">
    <div class="menu-contents-inner">
      <PageTopNav />
    </div>
  </Fragment>
  <Fragment slot="body-slot">
    <div class="album-title">
      <h1><span>{title}</span>{visibility !== "public" && <span class="gallery-audience-icon" role="img" aria-label={audience} title={audience}><MemberIcon kind="membersOnly" class="gallery-audience-svg" /></span>}</h1>
      <slot name="album-actions" />
    </div>
    <div class="gallery-detail-wrapper">
      <slot />
    </div>
  </Fragment>
</Layout>

<style>
  .album-title {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .album-title h1 {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: #000;
    font-family: YakuHanMP, "Zen Old Mincho";
    font-size: 48px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 7.2px;
  }

  .gallery-detail-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .album-title h1 {
      font-size: 24px;
      letter-spacing: 3.6px;
    }
  }
</style>
