{
  "name": "Scharade-HomePage",
  "type": "module",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "astro dev",
    "start": "node --import=./scripts/require-secure-runtime.mjs --env-file=.env dist/server/entry.mjs",
    "build": "node scripts/require-secure-runtime.mjs && node scripts/prepare-images.mjs && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "runtime:check": "node scripts/require-secure-runtime.mjs",
    "test": "node --import=./scripts/require-secure-runtime.mjs --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "admin:create": "node --env-file=.env --experimental-strip-types scripts/admin.mjs",
    "admin:password": "node --env-file=.env --experimental-strip-types scripts/admin.mjs --password",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@pdf-lib/fontkit": "1.1.1",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.8",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "highs": "1.15.4",
    "microcms-js-sdk": "^3.2.0",
    "nodemailer": "10.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "^1.63.0",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "jsqr": "1.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "private": true,
  "resolutions": {
    "yaml": "2.9.1",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "undici": "8.12.3",
    "zod": "4.6.7"
  }
}
