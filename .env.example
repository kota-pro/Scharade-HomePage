# Copy to .env. Never commit .env or .data. Prefer DATA_DIR outside the checkout on VPS.
# Enable only after APNs/FCM credentials and test-device verification are complete.
PUSH_DELIVERY_ENABLED=0
# Enable enhanced push security in the user-owned Expo project. Server-only access token.
EXPO_ACCESS_TOKEN=
# Public app association identifiers. Use the Google Play app-signing certificate, not the upload key.
APPLE_TEAM_ID=
ANDROID_APP_SIGNING_SHA256=
SITE_URL=https://scharade.jp
HOST=127.0.0.1
PORT=4321
DATA_DIR=/home/ubuntu/scharade-data
# Set only when Nginx overwrites X-Real-IP and Node is reachable only via Nginx.
TRUST_PROXY=1
# Browser-visible Google Maps key for About us. Rebuild after changing.
PUBLIC_GOOGLE_MAPS_API_KEY=
MICROCMS_SERVICE_DOMAIN=
# Hobby supports one key. Rotate the exposed key; do not reuse MICROCMS_API_KEY.
# Server only: blog/card_image GET; portfolio GET/POST/PATCH/DELETE;
# Management: media upload and content metadata for deletion retries only.
MICROCMS_SERVER_API_KEY=
MICROCMS_PORTFOLIO_ENDPOINT=portfolio
MICROCMS_PORTFOLIO_GRADE_FIELD=grade
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_REFRESH_TOKEN=
LIGHTROOM_CATALOG_ID=
# Generate each secret independently: openssl rand -hex 32
SIGNUP_REVIEW_SECRET=
GALLERY_SIGNING_SECRET=
# Email MFA HMAC key, exactly 64 hex characters. Retain the existing key; back up separately from member data.
MFA_ENCRYPTION_KEY=
GMAIL_PASS=
# Optional existing Instagram integration. Leave unset if unused.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
# Accounting intake web app. Keep the shared secret on the server only.
ACCOUNTING_GAS_URL=
ACCOUNTING_WEBHOOK_SECRET=
# Exhibition Forms gateway. Deploy gas/exhibition/Code.gs as a Web App and set
# the same generated shared secret in its Script Properties.
EXHIBITION_GAS_URL=
EXHIBITION_WEBHOOK_SECRET=

# New files belong to sharadeshashinten@gmail.com; legacy forms keep the gateway above.
EXHIBITION_DRIVE_GAS_URL=
EXHIBITION_DRIVE_WEBHOOK_SECRET=
