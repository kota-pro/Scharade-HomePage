{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "src/**/*", "src/types/**/*"],
  "exclude": [
    "dist",
    "next-app",
    "mobile",
    "moblie",
    "video-guide",
    "tests/mobile-routing.test.ts",
    "scripts/prepare-mobile-assets.mjs",
    "playwright-report",
    "test-results",
    "node_modules"
  ],
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/types"]
  }
}
